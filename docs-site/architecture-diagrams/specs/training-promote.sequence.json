        "id": "start",
        "label": "Preflight and start",
        "focus": [
          "client",
          "api",
          "arbiter",
          "jobs"
        ],
        "note": "The API checks the spec, claims GPUs and enqueues a train job on the gpu_train queue. It never calls the trainer."
      },
      {
        "id": "train",
        "label": "The trainer runs",
        "focus": [
          "trainer",
          "jobs",
          "api"
        ],
        "note": "The trainer owns the run; the API only reads the job and run rows it updates."
      },
      {
        "id": "promote",
        "label": "Gated promote",
        "focus": [
          "client",
          "api",
          "jobs",
          "triton"
        ],
        "note": "Promote checks the eval block, writes the model repository and loads the model."
      }
    ]
