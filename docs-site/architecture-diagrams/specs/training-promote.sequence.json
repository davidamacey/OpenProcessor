  "cards": [
    {
      "dot": "cyan",
      "title": "Jobs, not RPC",
      "items": [
        "The API enqueues the job; the trainer claims it, heartbeats, and stores the manifest and run log against the training_runs row",
        "One trainer serves every project; any worker handling the train job can replace it"
      ]
    },
    {
      "dot": "rose",
      "title": "GPU arbiter",
      "items": [
        "Claims GPUs on start: pauses a paired worker or stops configured containers",
        "A reconcile loop releases them once no run is active"
      ]
    },
    {
      "dot": "emerald",
      "title": "Promote gate",
      "items": [
        "mAP50 >= 0.65, per-class precision >= 0.50, support >= 5",
        "force=true bypasses; a subset run's class remap is applied to labels.txt"
      ]
    }
  ]
