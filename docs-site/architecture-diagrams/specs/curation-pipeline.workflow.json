    },
    {
      "id": "detect-embed",
      "from": "detect",
      "to": "embed",
      "label": "item crops",
      "variant": "emphasis"
    },
    {
      "id": "embed-cluster",
      "from": "embed",
      "to": "cluster",
      "variant": "emphasis"
    },
    {
      "id": "seed-region",
      "from": "embed",
