      "lane": "ingest",
      "col": 1,
      "type": "backend",
      "label": "Item detector",
      "sublabel": "OP_INGEST_PRIMARY_*",
      "width": 140
    },
    {
      "id": "embed",
      "lane": "ingest",
      "col": 2,
      "type": "backend",
      "label": "PE-Core embed",
      "sublabel": "pe_embedding 1024-d",
