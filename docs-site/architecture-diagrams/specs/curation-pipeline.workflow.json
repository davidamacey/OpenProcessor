{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Curation Pipeline",
    "locale": "en",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "into-the-pool",
        "label": "Into the item pool",
        "focus": [
          "ingest",
          "detect",
          "embed",
          "region"
        ],
        "note": "Ingest proposes items with your detector, embeds them with PE-Core, and seeds region work."
      },
      {
        "id": "label",
        "label": "Cluster, suggest, review",
        "focus": [
          "embed",
          "cluster",
          "vlm",
          "review"
        ],
        "note": "Clusters and VLM suggestions narrow what a human has to look at in the review queues."
      },
      {
        "id": "train-loop",
        "label": "Export to promote",
        "focus": [
          "review",
          "export",
          "train",
          "bakeoff",
          "promote"
        ],
        "note": "Validated labels become a frozen export, a training run, a comparison and a served model."
      }
    ],
    "legend": {
      "entries": {
        "frontend": {
          "label": "HTTP"
        },
        "backend": {
          "label": "Step"
        },
        "database": {
          "label": "Dataset"
        },
        "cloud": {
          "label": "Triton"
        },
        "external": {
          "label": "VLM"
        }
      }
    }
  },
