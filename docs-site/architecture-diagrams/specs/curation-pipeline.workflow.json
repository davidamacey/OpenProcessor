      "role": "return",
      "route": "return-left"
    },
    {
      "id": "export-train",
      "from": "export",
      "to": "train",
      "label": "job.json"
    },
    {
      "id": "train-bakeoff",
      "from": "train",
      "to": "bakeoff"
    },
    {
      "id": "bakeoff-promote",
      "from": "bakeoff",
      "to": "promote",
      "label": "winner"
    },
    {
      "id": "promote-review",
      "from": "promote",
      "to": "review",
      "label": "probe",
      "variant": "dashed",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Bring your own models",
      "items": [
        "You supply the item detector; PE-Core encoders are required",
        "The VLM, region profile and segmenter are optional",
        "Ingest 503s until an item detector is configured"
      ]
    },
    {
      "dot": "emerald",
      "title": "Humans stay in charge",
      "items": [
        "VLM answers are suggestions until confirmed",
        "Every label write is undoable and keeps its class_source",
        "auto_label clusters only unless run_vlm=true"
      ]
    },
    {
      "dot": "orange",
      "title": "Closing the loop",
      "items": [
        "Promote is gated on mAP50 and per-class precision/support",
        "Probe predictions feed the model_disagreements queue",
        "The API and trainer only exchange files; see the Training + promote sequence"
      ]
    }
  ]
}
