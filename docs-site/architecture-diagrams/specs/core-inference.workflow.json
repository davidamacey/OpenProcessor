  "cards": [
    {
      "dot": "cyan",
      "title": "One gRPC client",
      "items": [
        "Every route shares one Triton gRPC client, so Triton's dynamic batcher sees concurrent requests together",
        "Boxes come back normalized to 0-1",
        "Green steps run on the API CPU; orange steps are Triton models on the GPU"
      ]
    },
    {
      "dot": "emerald",
      "title": "Composed routes",
      "items": [
        "/analyze runs detection, faces, CLIP and OCR on one image",
        "/ingest also writes global, face, object and OCR documents to OpenSearch for /search/*"
      ]
    },
    {
      "dot": "orange",
      "title": "Runtime model control",
      "items": [
        "Triton runs in explicit model-control mode",
        "?model_name= selects any loaded detector; POST /models/{name}/load|unload",
        "Models a curation project promotes load the same way, as {slug}__name"
      ]
    }
  ]
