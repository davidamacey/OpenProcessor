    "views": [
      { "id": "project", "label": "One project", "focus": ["op_images", "op_items", "op_classes", "registry", "op_configs", "op_umap"], "note": "A project owns six indexes plus its class registry and exports. Items are crops of images; each item carries a region_boxes list." },
      { "id": "global", "label": "Global indexes", "focus": ["op_projects", "op_global", "op_configs"], "note": "op_projects holds the project records; op_global_configs holds the VLM endpoint registry shared by every project." },
      { "id": "search", "label": "Search indexes", "focus": ["vs_global", "vs_faces", "vs_objects", "vs_ocr"], "note": "The core /ingest route writes one global document per image plus face, object and OCR documents. They belong to no project." }
    ],
    "legend": { "entries": { "database": { "label": "Index" }, "external": { "label": "File" }, "backend": { "label": "State" } } }
  },
  "components": [
    { "id": "op_images", "type": "database", "label": "images", "sublabel": "image_id / imohash / pe_embedding", "pos": [40, 110], "size": [230, 64] },
    { "id": "op_items", "type": "database", "label": "items", "sublabel": "crop_id / bbox_norm / class_id", "pos": [360, 110], "size": [230, 64], "tag": "region_boxes[] / vlm_* / probe_*" },
    { "id": "op_classes", "type": "database", "label": "classes", "sublabel": "class_id / class_name / group", "pos": [680, 110], "size": [230, 64] },
    { "id": "registry", "type": "external", "label": "class_registry.json", "sublabel": "data/projects/<slug>/", "pos": [680, 270], "size": [230, 64] },
    { "id": "op_configs", "type": "database", "label": "configs", "sublabel": "packs / profiles / keymap / settings", "pos": [360, 270], "size": [230, 64], "tag": "revisions + activations" },
    { "id": "op_umap", "type": "backend", "label": "umap_state", "sublabel": "clustering reducer cache", "pos": [40, 270], "size": [230, 64] },
    { "id": "op_labels", "type": "database", "label": "labels_confirmed", "sublabel": "legacy, nothing writes it", "pos": [40, 400], "size": [230, 64] },
    { "id": "exports", "type": "external", "label": "exports/ + bakeoff_eval/", "sublabel": "data/projects/<slug>/", "pos": [680, 400], "size": [230, 64] },
    { "id": "op_projects", "type": "database", "label": "op_projects", "sublabel": "one record per project", "pos": [40, 590], "size": [230, 64], "tag": "status / revision / resources" },
