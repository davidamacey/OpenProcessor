    { "id": "vs_faces", "type": "database", "label": "visual_search_faces", "sublabel": "face_id / ArcFace 512-d", "pos": [40, 920], "size": [230, 64] },
    { "id": "vs_objects", "type": "database", "label": "visual_search_vehicles / people", "sublabel": "box / crop embedding", "pos": [360, 920], "size": [230, 64] },
    { "id": "vs_ocr", "type": "database", "label": "visual_search_ocr", "sublabel": "text + boxes", "pos": [680, 920], "size": [230, 64] }
  ],
  "boundaries": [
    { "kind": "region", "label": "Per project: op_prj_<slug>__<role>", "wraps": ["op_images", "op_items", "op_classes", "registry", "op_configs", "op_umap", "op_labels", "exports"] },
    { "kind": "region", "label": "Global (no project)", "wraps": ["op_projects", "op_global"] },
    { "kind": "region", "label": "Visual search (core /ingest, /search)", "wraps": ["vs_global", "vs_faces", "vs_objects", "vs_ocr"] }
  ],
  "connections": [
    { "id": "items-images", "from": "op_items", "to": "op_images", "label": "image_id" },
    { "id": "items-classes", "from": "op_items", "to": "op_classes", "label": "class_id" },
    { "id": "registry-classes", "from": "registry", "to": "op_classes", "label": "sync", "variant": "dashed" },
    { "id": "configs-items", "from": "op_configs", "to": "op_items", "label": "region_profile@rev", "variant": "dashed" },
    { "id": "exports-registry", "from": "exports", "to": "registry", "label": "class names", "variant": "dashed" },
    { "id": "projects-configs", "from": "op_projects", "to": "op_configs", "label": "resources", "variant": "dashed" },
    { "id": "faces-global", "from": "vs_faces", "to": "vs_global", "label": "image_id" },
    { "id": "objects-global", "from": "vs_objects", "to": "vs_global", "label": "image_id" },
