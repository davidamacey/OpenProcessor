  "cards": [
    {
      "dot": "cyan",
      "title": "Core (always on)",
      "items": [
        "api, triton-server and opensearch are the only services without a compose profile",
        "One shared Triton gRPC client lets Triton's dynamic batcher form batches",
        "No authentication on any route: run behind your own proxy"
      ]
    },
    {
      "dot": "emerald",
      "title": "Opt-in profiles",
      "items": [
        "curation: detection, VLM, auto-label and cluster-refresh workers plus the evaluator, shared by all projects",
        "segmenter, vlm and training each start their own GPU service",
        "The API also calls the VLM directly for /curation/projects/{project}/vlm/* routes"
      ]
    },
    {
      "dot": "orange",
      "title": "File protocols",
      "items": [
        "Training: job.json in, status.json / run.log / manifest.json out, per project",
        "Bake-off jobs are files the evaluator watches, per project",
        "Promote writes the model repository as {slug}__name and asks Triton to load it"
      ]
    }
  ]
