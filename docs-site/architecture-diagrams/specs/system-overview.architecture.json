    "views": [
      {
        "id": "core-path",
        "label": "Core inference path",
        "focus": [
          "client",
          "api",
          "triton",
          "opensearch"
        ],
        "note": "The core services: the API calls Triton over gRPC and indexes into OpenSearch."
      },
      {
        "id": "projects",
        "label": "Projects",
        "focus": [
          "api",
          "opensearch",
          "jobs",
          "workers"
        ],
        "note": "Each request binds one project. Every project has its own indexes and job directories; workers visit them in turn."
      },
      {
        "id": "curation-workers",
        "label": "Curation workers",
        "focus": [
          "workers",
          "triton",
          "opensearch",
          "segmenter",
          "vlm"
        ],
        "note": "One set of workers visits every active project, reading and writing its items, using its active profile, pack and VLM endpoint."
      },
      {
        "id": "training",
        "label": "Training and model comparison",
        "focus": [
          "api",
          "jobs",
          "trainer",
          "evaluator",
          "mlflow",
          "triton"
        ],
        "note": "The API writes job files; trainer and evaluator pick them up. Promote loads the run into Triton."
      },
      {
        "id": "vlm-select",
        "label": "VLM selection",
        "focus": [
          "cli",
          "api",
          "vlm",
          "workers"
        ],
        "note": "The API records the desired local model; the host CLI recreates the vLLM container. Projects activate registered endpoints."
      }
    ]
  },
