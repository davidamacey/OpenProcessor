  "cards": [
    {
      "dot": "cyan",
      "title": "Services before routers",
      "items": [
        "src/services/ has no FastAPI dependency and is tested on its own",
        "Routers are thin HTTP adapters"
      ]
    },
    {
      "dot": "emerald",
      "title": "Config, not forks",
      "items": [
        "CurationConfig, RegionFields, DetectionProfile and RegionStatus hold everything domain-specific",
        "OP_* variables are read at import time"
      ]
    },
    {
      "dot": "orange",
      "title": "One wire vocabulary",
      "items": [
        "wire.py turns storage fields into region_*, vlm_*, classifier_* names",
        "OCC helpers keep human labels safe from concurrent writers"
      ]
    }
