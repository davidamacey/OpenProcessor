{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Region Detection Cascade",
    "locale": "en",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "legs",
        "label": "Detection legs",
        "focus": [
          "pending",
          "detector",
          "segmenter",
          "texthint"
        ],
        "note": "Each leg runs only when the one before it missed; candidates are merged and capped."
      },
      {
        "id": "verify",
        "label": "Verify and read",
        "focus": [
          "existing",
          "select",
          "verify",
          "readtext"
        ],
        "note": "Up to max_regions_per_item boxes go to one VLM call (or are accepted without one); each box gets its own verdict and text."
      },
      {
        "id": "no-region",
        "label": "No region",
        "focus": [
          "texthint",
          "no_box",
          "verify",
          "rejected"
        ],
        "note": "Misses and all-rejected sets become terminal statuses a human can review, and reprocess."
      }
    ],
    "legend": {
      "entries": {
        "database": {
          "label": "Queue"
        },
        "cloud": {
          "label": "Model"
        },
        "backend": {
          "label": "Worker"
        },
        "external": {
          "label": "VLM"
        },
        "security": {
          "label": "Terminal"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "legs",
      "label": "Detection legs"
    },
    {
      "id": "verify",
      "label": "Verify + read"
    },
    {
      "id": "outcome",
      "label": "No region",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "pending",
    "detector",
    "select",
    "verify",
    "readtext"
  ],
  "nodes": [
    {
      "id": "pending",
      "lane": "legs",
      "col": 0,
      "type": "database",
      "label": "Item queued",
      "sublabel": "pending_detection",
      "width": 140
    },
    {
      "id": "detector",
      "lane": "legs",
      "col": 1,
      "type": "cloud",
      "label": "Region detector",
      "sublabel": "Triton, profile model",
      "width": 140
    },
    {
      "id": "segmenter",
      "lane": "legs",
      "col": 2,
      "type": "backend",
      "label": "Segmenter leg",
      "sublabel": "SAM 3 text prompt",
      "width": 140
    },
    {
      "id": "texthint",
      "lane": "legs",
      "col": 3,
      "type": "backend",
      "label": "OCR text hint",
      "sublabel": "re-segment sub-crop",
      "width": 140
    },
    {
      "id": "existing",
      "lane": "verify",
      "col": 0,
      "type": "database",
      "label": "Candidate exists",
      "sublabel": "pending_verification",
      "width": 140
    },
    {
      "id": "verify",
      "lane": "verify",
      "col": 4,
      "type": "external",
      "label": "VLM verify",
      "sublabel": "numbered boxes",
      "width": 140
    },
    {
      "id": "readtext",
      "lane": "verify",
      "col": 5,
      "type": "backend",
      "label": "Read text per box",
      "sublabel": "VLM / OCR",
      "tag": "detected",
      "width": 140
    },
    {
      "id": "no_box",
      "lane": "outcome",
      "col": 3,
      "type": "security",
      "label": "No region",
      "sublabel": "no_region_box",
      "width": 140
    },
    {
      "id": "rejected",
      "lane": "outcome",
      "col": 5,
      "type": "security",
      "label": "All rejected",
      "sublabel": "verify_rejected",
      "width": 140
    },
    {
      "id": "select",
      "lane": "verify",
      "col": 2,
      "type": "backend",
      "label": "Select boxes",
      "sublabel": "NMS + box cap",
      "width": 140
    }
  ],
  "edges": [
    {
      "id": "queue-detector",
      "from": "pending",
      "to": "detector",
      "variant": "emphasis"
    },
    {
      "id": "detector-miss",
      "from": "detector",
      "to": "segmenter",
      "label": "miss"
    },
    {
      "id": "segmenter-miss",
      "from": "segmenter",
      "to": "texthint",
      "label": "miss"
    },
    {
      "id": "texthint-miss",
      "from": "texthint",
      "to": "no_box",
      "label": "miss",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "existing-verify",
      "from": "existing",
      "to": "verify"
    },
    {
      "id": "verify-read",
      "from": "verify",
      "to": "readtext",
      "label": "confirmed",
      "variant": "emphasis"
    },
    {
      "id": "verify-reject",
      "from": "verify",
      "to": "rejected",
      "label": "rejected",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "detector-hit",
      "from": "detector",
      "to": "select",
      "label": "hit",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "segmenter-hit",
      "from": "segmenter",
      "to": "select",
      "label": "hit"
    },
    {
      "id": "texthint-hit",
      "from": "texthint",
      "to": "select",
      "label": "hit"
    },
    {
      "id": "select-verify",
      "from": "select",
      "to": "verify",
      "label": "N candidates",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "One active profile per project",
      "items": [
        "The project's active region profile names the detector, segmenter prompt, OCR models and box cap",
        "With no profile active for a project the worker skips it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Per-box states",
      "items": [
        "Each box is proposed, accepted, rejected or false_positive; the item status derives from them",
        "Human-owned boxes are locked: the worker plans around them and never rewrites them",
        "Each step is recorded in region_detector_chain"
      ]
    },
    {
      "dot": "rose",
      "title": "Failures are not verdicts",
      "items": [
        "A down dependency leaves the item pending, not terminal",
        "detection_failed marks an unreadable image or a sanity-gate reject",
        "A human can mark a box false_positive; reprocess retries the rest"
      ]
    }
  ]
}
