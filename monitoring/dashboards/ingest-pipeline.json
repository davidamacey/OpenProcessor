          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (stage) (rate(op_pipeline_stage_bytes_total{stage=~\"$stage\"}[$__rate_interval]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
