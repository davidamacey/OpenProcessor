        }
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      }
    },
    {
      "type": "heatmap",
      "title": "Stage duration distribution",
      "description": "Heatmap of stage call durations (all selected stages).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (le) (increase(op_pipeline_stage_seconds_bucket{stage=~\"$stage\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "color": {
          "scheme": "Turbo",
          "mode": "scheme"
        },
        "yAxis": {
          "unit": "s"
