          "expr": "sum(rate(op_source_image_prefetch_hits_total[$__rate_interval])) / clamp_min(sum(rate(op_source_image_prefetch_hits_total[$__rate_interval])) + sum(rate(op_source_image_prefetch_misses_total[$__rate_interval])), 1e-9)",
