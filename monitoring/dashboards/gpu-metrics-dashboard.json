{
  "uid": "gpu-metrics",
  "title": "OpenProcessor / GPUs",
  "description": "Per-GPU utilization, VRAM, power, thermals, clocks and codecs from DCGM.",
  "tags": [
    "openprocessor",
    "gpu"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "OpenProcessor dashboards",
      "type": "dashboards",
      "tags": [
        "openprocessor"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Firing alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "enable": true,
        "iconColor": "#E02F44",
        "expr": "ALERTS{alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} {{instance}}",
        "step": "60s"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "type": "query",
        "name": "gpu",
        "label": "GPU",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(DCGM_FI_DEV_GPU_UTIL, gpu)",
          "refId": "vgpu"
        },
        "definition": "label_values(DCGM_FI_DEV_GPU_UTIL, gpu)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Cards at a glance",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "text",
      "title": "",
      "id": 2,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "options": {
        "mode": "markdown",
        "content": "Current state of each GPU (3-card layout: use the gpu variable to focus one). Source: DCGM, which sees every process on the card."
      },
      "transparent": true
    },
    {
      "type": "gauge",
      "title": "Utilization",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "DCGM_FI_DEV_GPU_UTIL{gpu=~\"$gpu\"}",
          "legendFormat": "GPU {{gpu}} {{modelName}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#56A64B",
                "value": null
              },
              {
                "color": "#E0B400",
                "value": 75
              },
              {
                "color": "#E02F44",
                "value": 95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdMarkers": true
      },
      "id": 3,
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 3
      }
    },
    {
      "type": "gauge",
      "title": "VRAM used",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "100 * DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"} / (DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"} + DCGM_FI_DEV_FB_FREE{gpu=~\"$gpu\"})",
          "legendFormat": "GPU {{gpu}} {{modelName}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#56A64B",
                "value": null
              },
              {
                "color": "#E0B400",
                "value": 85
              },
              {
                "color": "#E02F44",
                "value": 95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdMarkers": true
      },
      "id": 4,
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 3
      }
    },
