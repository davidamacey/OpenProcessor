{
  "grammar": {
    "modifiers": ["ctrl", "meta", "alt", "shift"],
    "named_keys": [
      "enter", "escape", "space", "tab", "backspace", "delete",
      "arrowleft", "arrowright", "arrowup", "arrowdown",
      "home", "end", "pageup", "pagedown"
    ],
    "printable": "abcdefghijklmnopqrstuvwxyz0123456789`~/\\[];',.-=?",
    "max_combos_per_action": 3,
    "locked_keys": ["escape", "enter", "arrowleft", "arrowright", "arrowup", "arrowdown"],
    "browser_reserved": [
      "ctrl+w", "ctrl+t", "ctrl+n", "ctrl+shift+t", "ctrl+tab", "ctrl+l", "ctrl+r", "ctrl+q",
      "meta+w", "meta+t", "meta+n", "meta+q", "meta+r", "meta+l",
      "alt+arrowleft", "alt+arrowright"
    ]
  },
  "contexts": [
    {"id": "global", "label": "Everywhere", "description": "Active on every page.", "includes": [], "class_hotkeys_live": true},
    {"id": "review", "label": "Review (every tab)", "description": "Scan mode on any /review tab.", "includes": ["global"], "class_hotkeys_live": true},
    {"id": "review.queue", "label": "Review queue", "description": "The core /review tabs.", "includes": ["review"], "class_hotkeys_live": true},
    {"id": "review.region", "label": "Region review", "description": "The region tab, scan mode.", "includes": ["review"], "class_hotkeys_live": true},
    {"id": "box_edit", "label": "Box editing", "description": "Region edit mode and the box editor.", "includes": ["global"], "class_hotkeys_live": false},
    {"id": "cluster", "label": "Cluster", "description": "A single cluster's crop grid.", "includes": ["global"], "class_hotkeys_live": true},
    {"id": "clusters_search", "label": "Cluster search", "description": "Semantic-search results on /clusters.", "includes": ["global"], "class_hotkeys_live": true},
    {"id": "region_gallery", "label": "Region gallery", "description": "The region gallery on /clusters.", "includes": ["global"], "class_hotkeys_live": false}
  ],
  "actions": [
    {"id": "global.shortcuts_overlay", "context": "global", "group": null, "label": "Toggle this panel", "description": "Show or hide the keyboard-shortcuts overlay.", "default": ["`", "shift+~"], "modifiable": true},
    {"id": "global.close_overlay", "context": "global", "group": "cancel", "label": "Close this panel / cancel", "description": "Close the shortcut overlay.", "default": ["escape"], "modifiable": false},

    {"id": "review.skip", "context": "review", "group": "skip", "label": "Skip", "description": "Skip this item.", "default": ["n"], "modifiable": true},
    {"id": "review.undo", "context": "review", "group": "undo", "label": "Undo last", "description": "Undo the last action.", "default": ["z"], "modifiable": true},

    {"id": "review.queue.confirm", "context": "review.queue", "group": "confirm", "label": "Confirm proposed & advance (or search classes if blank)", "description": "Confirm the proposed label and advance.", "default": ["enter"], "modifiable": true},
    {"id": "review.queue.discard", "context": "review.queue", "group": "discard", "label": "Discard", "description": "Dismiss this item from every review queue.", "default": ["d"], "modifiable": true},
    {"id": "review.queue.class_picker", "context": "review.queue", "group": null, "label": "Search all classes...", "description": "Open the class-assignment picker.", "default": ["/"], "modifiable": true},
    {"id": "review.queue.prev", "context": "review.queue", "group": "prev", "label": "Previous item", "description": "Go to the previous item.", "default": ["arrowleft"], "modifiable": true},
    {"id": "review.queue.next", "context": "review.queue", "group": "next", "label": "Next item", "description": "Go to the next item.", "default": ["arrowright"], "modifiable": true},

    {"id": "review.region.confirm", "context": "review.region", "group": "confirm", "label": "Confirm region & advance", "description": "Confirm the region and advance.", "default": ["enter"], "modifiable": true},
    {"id": "review.region.reject", "context": "review.region", "group": "reject", "label": "Reject (no region visible)", "description": "Mark that the item shows no region.", "default": ["d"], "modifiable": true},
    {"id": "review.region.false_positive", "context": "review.region", "group": null, "label": "False positive (keep box)", "description": "Mark the region a false positive but keep its box.", "default": ["f"], "modifiable": true},
    {"id": "review.region.edit_box", "context": "review.region", "group": null, "label": "Edit region box", "description": "Enter box-edit mode for this region.", "default": ["e"], "modifiable": true},
    {"id": "review.region.back", "context": "review.region", "group": "prev", "label": "Step back to last confirmed region", "description": "Step back one region.", "default": ["arrowleft", "b"], "modifiable": true},
    {"id": "review.region.next", "context": "review.region", "group": "next", "label": "Next item", "description": "Go to the next item.", "default": ["arrowright"], "modifiable": true},
    {"id": "review.region.accept_box", "context": "review.region", "group": null, "label": "Accept selected region box", "description": "Set the selected box to accepted.", "default": ["y"], "modifiable": true},
    {"id": "review.region.reject_box", "context": "review.region", "group": null, "label": "Reject selected region box", "description": "Set the selected box to rejected.", "default": ["r"], "modifiable": true},

    {"id": "box_edit.save", "context": "box_edit", "group": "confirm", "label": "Save region & exit edit", "description": "Save the box and leave edit mode.", "default": ["enter"], "modifiable": true},
    {"id": "box_edit.cancel", "context": "box_edit", "group": "cancel", "label": "Cancel edit", "description": "Cancel box editing.", "default": ["escape"], "modifiable": false},
    {"id": "box_edit.nudge_up", "context": "box_edit", "group": "nudge", "label": "Move box up", "description": "Nudge the box up.", "default": ["arrowup"], "modifiable": true},
    {"id": "box_edit.nudge_down", "context": "box_edit", "group": "nudge", "label": "Move box down", "description": "Nudge the box down.", "default": ["arrowdown"], "modifiable": true},
    {"id": "box_edit.nudge_left", "context": "box_edit", "group": "nudge", "label": "Move box left", "description": "Nudge the box left.", "default": ["arrowleft"], "modifiable": true},
    {"id": "box_edit.nudge_right", "context": "box_edit", "group": "nudge", "label": "Move box right", "description": "Nudge the box right.", "default": ["arrowright"], "modifiable": true},
    {"id": "box_edit.shrink_right", "context": "box_edit", "group": null, "label": "Move right edge left", "description": "Shrink the box from the right.", "default": ["["], "modifiable": true},
    {"id": "box_edit.grow_right", "context": "box_edit", "group": null, "label": "Move right edge right", "description": "Grow the box to the right.", "default": ["]"], "modifiable": true},
    {"id": "box_edit.delete_box", "context": "box_edit", "group": null, "label": "Clear the box", "description": "Delete the selected box.", "default": ["backspace"], "modifiable": true},
    {"id": "box_edit.next_box", "context": "box_edit", "group": "next", "label": "Select the next box", "description": "Select the next box.", "default": ["tab"], "modifiable": true},

    {"id": "cluster.confirm", "context": "cluster", "group": "confirm", "label": "Confirm selected & advance", "description": "Confirm the selected crops.", "default": ["enter"], "modifiable": true},
    {"id": "cluster.accept_all_vlm", "context": "cluster", "group": null, "label": "Confirm all VLM suggestions on page", "description": "Accept every VLM suggestion on the page.", "default": ["shift+enter"], "modifiable": true},
    {"id": "cluster.accept_vlm", "context": "cluster", "group": null, "label": "Accept VLM suggestion for selected", "description": "Accept the VLM suggestion for the selected crop.", "default": ["g"], "modifiable": true},
    {"id": "cluster.skip", "context": "cluster", "group": "skip", "label": "Skip selected", "description": "Skip the selected crops.", "default": ["n"], "modifiable": true},
    {"id": "cluster.flag_new_class", "context": "cluster", "group": null, "label": "Flag selected as needing new class", "description": "Flag the selection for curator review.", "default": ["shift+n"], "modifiable": true},
    {"id": "cluster.discard", "context": "cluster", "group": "discard", "label": "Discard selected", "description": "Discard the selected crops.", "default": ["d"], "modifiable": true},
    {"id": "cluster.undo", "context": "cluster", "group": "undo", "label": "Undo last action", "description": "Undo the last action.", "default": ["z"], "modifiable": true},
    {"id": "cluster.ignore", "context": "cluster", "group": "ignore", "label": "Ignore selected (exclude from training)", "description": "Ignore the selected crops.", "default": ["x"], "modifiable": true},
    {"id": "cluster.unignore", "context": "cluster", "group": null, "label": "Undo last ignore", "description": "Restore the last ignored crop.", "default": ["u"], "modifiable": true},
    {"id": "cluster.select_all", "context": "cluster", "group": "select_all", "label": "Select all on page", "description": "Select every visible crop.", "default": ["a"], "modifiable": true},
    {"id": "cluster.prev", "context": "cluster", "group": "prev", "label": "Previous crop", "description": "Go to the previous crop.", "default": ["arrowleft"], "modifiable": true},
    {"id": "cluster.next", "context": "cluster", "group": "next", "label": "Next crop", "description": "Go to the next crop.", "default": ["arrowright"], "modifiable": true},
    {"id": "cluster.move", "context": "cluster", "group": null, "label": "Move selected to cluster...", "description": "Move the selection to another cluster.", "default": ["m"], "modifiable": true},
    {"id": "cluster.cancel", "context": "cluster", "group": "cancel", "label": "Clear drag capture / close picker / clear selection", "description": "Cancel the current cluster interaction.", "default": ["escape"], "modifiable": false},

    {"id": "clusters_search.select_all", "context": "clusters_search", "group": "select_all", "label": "Select all results", "description": "Select every search result.", "default": ["a"], "modifiable": true},
    {"id": "clusters_search.cancel", "context": "clusters_search", "group": "cancel", "label": "Clear selection", "description": "Cancel semantic search mode.", "default": ["escape"], "modifiable": false},
    {"id": "clusters_search.ignore", "context": "clusters_search", "group": "ignore", "label": "Ignore selected (exclude from training)", "description": "Ignore the selected results.", "default": ["x"], "modifiable": true},
    {"id": "clusters_search.undo", "context": "clusters_search", "group": "undo", "label": "Undo last action", "description": "Undo the last action.", "default": ["z"], "modifiable": true},

    {"id": "region_gallery.undo", "context": "region_gallery", "group": "undo", "label": "Undo last region action", "description": "Undo the last region-gallery action.", "default": ["z"], "modifiable": true}
  ]
}
