# ---- Trainer container only (docker/trainer/, profile `training`) -----------
# Scratch root for per-job subset/augmentation rewrites. Always cleaned up at
# job end; inside the container this is a tmpfs.
# OP_TRAIN_TMP_ROOT=/tmp
# Host GPU ids the trainer container is attached to, in the SAME order as the
# compose service's `device_ids`. job.json names host ids; inside a container
# pinned to a GPU subset they appear as positional local indices. Leave unset
# when the container sees every GPU at its host index. G-14: docker-compose.yml
# interpolates BOTH this var and curation-trainer's device_ids from it, so
# setting it here moves both together for the single-GPU default. A
# multi-GPU OP_TRAIN_GPU_ORDER (e.g. "0,2") needs a compose override file
# for device_ids too -- see the comment beside curation-trainer's
# device_ids in docker-compose.yml.
# OP_TRAIN_GPU_ORDER=0
# Host GPU index the auto-label worker gets under `make cluster-gpu`
# (docker-compose.gpu-clustering.yml). cuML clustering needs a worker image
# with cuml + cupy; see docs/research/gpu_clustering.md.
# OP_CLUSTER_GPU_DEVICE=0
# Class names whose content is orientation-sensitive (text, digits, signage).
# Horizontal flip is disabled for any run that trains one of them. Matched
# case-insensitively against the training data.yaml's `names`. Per-job
# override: job.json's `augmentation.text_class_names`.
# OP_TRAIN_TEXT_CLASS_NAMES=
# Triton models to compare a finished run against, in preference order; the
# first one Triton reports READY wins. Unset (default) skips the comparison
# and leaves status.compare null.
# OP_TRAIN_INCUMBENT_MODELS=
# OP_TRAIN_COMPARE_MAX_IMAGES=200
# OP_TRAIN_COMPARE_INPUT_SIZE=640
# Triton model repository. Read by the trainer (to read an incumbent's
# labels.txt so comparison rows carry names, not bare ids) AND by yolo-api's
# promote path (src/services/training/triton_promote.py) and model discovery
# (src/routers/curation/models.py) -- the promote writer and the running
# Triton server must agree on this path or a promoted model silently lands
# somewhere Triton never sees. Must match whatever host directory is
# bind-mounted into BOTH yolo-api and triton-server; main's own
# docker-compose.yml mounts it at /app/models for yolo-api, so this normally
# doesn't need to be set there -- set it explicitly in any deployment overlay
# that mounts the repo somewhere else (e.g. /models).
# OP_TRITON_MODEL_REPO=/models
# OP_TRITON_HTTP_URL=http://triton-server:8000
# API base the trainer POSTs a campaign's auto-promote to (joined with
# OP_API_PREFIX).
# OP_API_BASE_URL=http://yolo-api:8000
# OP_TRAIN_LOG_LEVEL=INFO
# MLflow (optional; every hook degrades to a warning when unreachable).
# MLFLOW_TRACKING_URI=http://curation-mlflow:5000
# MLFLOW_EXPERIMENT_NAME=openprocessor
# OP_MLFLOW_MODEL_NAME=openprocessor_detector
# OP_MLFLOW_CONFUSION_MATRIX_EVERY=25
# Browser-reachable base URL for the MLflow UI (e.g. a reverse-proxied
# https://mlflow.example.com). MLFLOW_TRACKING_URI above is a container
# hostname the trainer uses internally and a browser can never resolve --
# the API rewrites the served train/status + train/manifest
# ``mlflow_run_url`` to use this base instead, and GET /curation/health
# serves it directly as mlflow_public_url. Unset = derived from the request
# host + OP_MLFLOW_PORT (see resource_links below).
# OP_MLFLOW_PUBLIC_URL=https://mlflow.example.com
# Served resource_links (GET /curation/projects/{project}/settings). Service links default to
# <the host the browser used>:<published port>, so LAN clients get their own
# host. The ports follow OP_<X>_PORT (compose defaults; 0 disables; `make
# dev-up` passes the stack's *_PORT values). Set OP_<X>_URL only to override
# verbatim, e.g. behind a reverse proxy. API docs links are path-relative, and
# with OP_GATEWAY_SUBPATHS=true so are the four service links.
# OP_GRAFANA_PORT=4605
# OP_PROMETHEUS_PORT=4604
# OP_DASHBOARDS_PORT=4608
# OP_MLFLOW_PORT=4609
# OP_GRAFANA_URL=https://grafana.example.com
# OP_PROMETHEUS_URL=
# OP_DASHBOARDS_URL=

# GPU arbiter (src/config/gpu_arbiter.py — GpuArbiterConfig.from_env).
# Comma-separated GPU ids a training / bake-off job may target; any other id
# is rejected at job submission. Unset/empty = unrestricted (any id).
# OP_GPU_ALLOWED_IDS=0,2
# Containers stopped (in order) while a run holds the GPUs and restarted
# when it releases them. Unset/empty = no container coordination. Each
# entry is a bare name (stopped only when a claim spans >1 GPU) or
# name@ids, where ids is /-separated (name@2, name@0/2) -- a scoped
# container is stopped whenever a claim intersects its GPU set, even a
# single-GPU claim.
# OP_GPU_ARBITER_CONTAINERS=
# Trainer container probed for reachability before a run starts.
# F-72: docker-compose.yml now wires this by default to
# ${COMPOSE_PROJECT_NAME:-openprocessor}-trainer (the trainer service's
# own container_name) whenever it's unset here, so a deployment running
# the `training` profile gets a working probe with no extra config.
# Set this only to override that default (e.g. a renamed/external
# trainer container). Empty string still means "skip the probe".
# OP_GPU_ARBITER_TRAINER_CONTAINER=
# Human-readable GPU card names for GET /curation/train/gpus option labels.
# Comma-separated id=label pairs. Unset ids just render as "GPU {id}".
# OP_GPU_LABELS=0=RTX A6000,1=RTX 3080 Ti,2=RTX A6000
# Default cuda_visible_devices for a new training spec. Unset = the
# smallest OP_GPU_ALLOWED_IDS entry, else '0' (unrestricted install).
# OP_TRAIN_DEFAULT_GPUS=
# Host GPU ids the bake-off evaluator container is attached to (e.g. '0';
# distinct from OP_BAKEOFF_GPUS below, which is the evaluator's
# container-local id). When set, enqueueing a bake-off -- and the reconcile
# loop while one is queued -- only stops configured containers whose GPU
# scope intersects these ids, instead of stopping everything configured.
# Unset = old behavior (stop every configured container on any bake-off).
# OP_BAKEOFF_HOST_GPUS=
# (While any project's bake-off job file is queued the arbiter keeps GPUs claimed.)

# =============================================================================
# Curation export (src/services/curation/export.py)
# =============================================================================
# Baked into yolo-api / curation-trainer / curation-evaluator at BUILD time
# (docker-compose.yml build.args) so every manifest's code_versions.api_sha
# and code_versions.trainer_sha reflect the actual built commit, not a dev
# checkout's live `git rev-parse HEAD` fallback (`make build`/`make rebuild`
# already pass this). Setting it here overrides the baked value at
# *runtime* instead — useful for a dev stack that bind-mounts src/ over a
# stale image.
# OP_BUILD_SHA=

# =============================================================================
# Curation model comparison / bake-off (src/routers/curation/bakeoff.py,
# scripts/curation/bakeoff/, curation-evaluator service)
# =============================================================================
# Eval datasets are every export of the project with a labelled test
# split, plus frozen external sets (TEST_FROZEN.json) under the project's
# OP_PROJECTS_DATA_ROOT/{slug}/bakeoff_eval/{curated,public,sample}. The evaluator must see both
# at the same paths as the API (compose mounts ./data read-only on it).
#
# The API queues each project's jobs in
# $OP_STATE_DIR/projects/<slug>/bakeoff_jobs (default included; not
# configurable). The evaluator watches $OP_STATE_DIR/bakeoff_jobs and finds
# the project dirs next to it, so it must see the state dir at the same path
# (its image default matches OP_STATE_DIR=/var/lib/openprocessor). The GPU
# arbiter keeps GPU-resident containers stopped while any project's job file
# is queued; OP_BAKEOFF_JOBS_DIR only adds one more dir for it to watch.
# OP_BAKEOFF_JOBS_DIR=/var/lib/openprocessor/bakeoff_jobs
# Evaluator parallelism and its container-local GPU ids.
# OP_BAKEOFF_CONCURRENCY=4
# OP_BAKEOFF_GPUS=0
# Registry of external baseline models served by
# GET /curation/bakeoff/baseline_models (default: the empty
# scripts/curation/bakeoff/baselines.json; previous training runs are the
# usual baselines).
# OP_BAKEOFF_BASELINES_PATH=
# Default BakeoffProfile when a job names none: a registered name (generic)
# or a path to a profile .json file. Unset = generic (scores every class in
# the test split). Example profiles are opt-in by path and need examples/
# mounted into both yolo-api and the evaluator, e.g. with ./examples mounted
# at /app/examples:
#   OP_BAKEOFF_PROFILE=/app/examples/bakeoff/license_plate/profile.json
# OP_BAKEOFF_PROFILE=
# Per-field overrides of the generic profile (scripts/curation/bakeoff/profile.py).
# Pattern: OP_BAKEOFF_PROFILE_<FIELD>, e.g. (comma lists; class names to score):
# OP_BAKEOFF_PROFILE_CLASS_FILTER=
# OP_BAKEOFF_PROFILE_CONTEXT_CLASS_IDS=

# =============================================================================
# Curation worker / pipeline flags (scripts/curation/, src/services/curation/autolabel/)
# =============================================================================
# OP_API=http://localhost:4603
# OP_AUTO_LABEL_STATE_DIR=/jobs/auto_label
# S-3: explicit override for where the detection worker POSTs
# crop.region_verified events (src/services/curation/event_hub.py). If
# unset, scripts/curation/worker/bulk_writer.py falls back to
# OP_API_BASE_URL, then OP_API — usually already set to the same host,
# so most deployments never need this var at all.
# OP_EVENT_API_URL=
# S-3: cross-process event bus backend. `file` (default) makes every
# uvicorn worker (and any process posting to /events/publish) see every
# published event via a shared JSONL log under
# {OP_STATE_DIR}/events/events.jsonl. `process` restores the pre-S-3
# in-process-only behavior (fine for a single-worker deployment or
# tests).
# OP_EVENT_BUS=file
# S-3: size (bytes) at which the shared event log rotates to a single
# `.1` backup — the log never exceeds roughly 2x this on disk.
# OP_EVENT_LOG_MAX_BYTES=8388608
# S-2: container-local dir the curation worker healthchecks read/write
# heartbeat files in (src/services/curation/worker_liveness.py). No
# mount needed — the healthcheck always runs inside the same container
# as the worker it's checking.
# OP_HEARTBEAT_DIR=/tmp/openprocessor_heartbeat
# OP_PAUSE_SENTINEL=/var/lib/openprocessor/vlm_worker/pause.sentinel
# OP_WORKER_PAUSE_SENTINEL=/var/lib/openprocessor/vlm_worker/pause.sentinel
# Seconds after which the GPU arbiter may clear a pause sentinel it did not create
# (e.g. one left by an interrupted `openprocessor vlm use`). Default 1800.
# OP_PAUSE_SENTINEL_TTL_S=1800
# OP_VIZ_JOBS_DIR=/jobs/viz
# OP_VIZ_MAX_N=20000
# BLAS thread caps for curation-auto-label-worker (AHC/UMAP on the residual
# pool otherwise spawns one thread per host core -- 48 on the reference
# host -- and starves everything else on a shared machine). Lower = slower
# clustering, less CPU contention; unset one and it inherits the library
# default (all cores).
# OMP_NUM_THREADS=4
# OPENBLAS_NUM_THREADS=4
# MKL_NUM_THREADS=4

# =============================================================================
# VLM (OpenAI-compatible /v1/chat/completions endpoint) — labeling +
# region-verification (src/services/labeling/vlm_client.py,
# scripts/curation/worker/state.py)
# =============================================================================
# W9: OP_VLM_URL / OP_VLM_MODEL are the built-in `env` VLM endpoint (read-only,
# the default a fresh project runs). More endpoints -- a remote vLLM, a hosted
# OpenAI-compatible API, Ollama on the host -- are REGISTERED through
# `POST /curation/vlm/endpoints` and activated per project; API keys are
# never put here or in the API: `openprocessor vlm key set <slug>` writes
# secrets/vlm/<slug> and an endpoint references it as `secret:<slug>`.
# G-10: three ways to get a VLM behind OP_VLM_URL:
#   1. Run the shipped `vlm` service: `docker compose --profile vlm up -d`,
#      then OP_VLM_URL=http://vlm:8000/v1 (below). See "In-compose VLM
#      (--profile vlm)" further down for its own knobs.
#   2. Point at one already running on THIS host (outside compose):
#      OP_VLM_URL=http://host.docker.internal:<port>/v1 -- yolo-api and
#      curation-vlm-worker both carry the `host.docker.internal:host-gateway`
#      extra_hosts entry needed for this to resolve on Linux (Docker
#      Desktop adds it for you; the Linux engine does not by default).
#   3. Point at a VLM on the network somewhere else:
#      OP_VLM_URL=http://<host>:<port>/v1.
# OP_VLM_URL=http://host.docker.internal:8012/v1
# OP_VLM_MODEL is REQUIRED whenever OP_VLM_URL is set -- there is no
# default model id; construction fails loudly without one.
# OP_VLM_MODEL=
# OP_VLM_API_KEY=EMPTY
# Open-vocab labeling chunk size only (default 3; clamped to the cap below).
# OP_VLM_OPEN_IMAGES_PER_CALL=3
# Per-request image cap for EVERY VLM call (labeling, verify, visibility,
# combined). Must be <= your serving engine's per-prompt image limit (vLLM:
# --limit-mm-per-prompt '{"image": N}') or requests 400. Default 8.
# OP_VLM_MAX_IMAGES_PER_CALL=8
# OP_VLM_HTTPX_MAX_CONNECTIONS=512
# OP_VLM_HTTPX_KEEPALIVE=128
# Detection worker (scripts/curation/worker): stage concurrency. The worker
# uses each project's ACTIVE VLM endpoint (the `env` one unless the project
# activated another) and swaps to a newly activated one at a quiesce point.
# OP_REGION_WORKER_VLM_CONCURRENCY=16
# OP_REGION_WORKER_VLM_VISIBLE_CONCURRENCY=8
# Prometheus metrics port for the region worker's own /metrics server.
# OP_REGION_WORKER_METRICS_PORT=4609
# The VLM and auto-label workers' /metrics ports (0 turns the endpoint off).
# If you change one, change the matching job in monitoring/prometheus.yml.
# OP_VLM_WORKER_METRICS_PORT=4610
# OP_AUTO_LABEL_WORKER_METRICS_PORT=4611
# Seconds between the API's OpenSearch samples of queue depth, embedding state
# and shard/store gauges (0 disables). Cap on projects that get their own
# `project` label on op_* metrics; the rest report as "other".
# OP_METRICS_REFRESH_INTERVAL_S=30
# OP_METRICS_MAX_PROJECT_LABELS=50
# OP_SEGMENTER_SKIP_VERIFY_SCORE=0.95
# How many VLM replies with no verdict (null box verdict, unparseable entry,
# empty visibility reply) an item gets per stage before the worker stops
# retrying it: the combined stage then writes verify_rejected with reason
# verifier_no_verdict (candidate kept for human review; requeue with
# --reason verifier_no_verdict), the visibility stage sends it on to
# detection. Counted in-process (a restart resets it); VLM transport
# failures never count. Default 3, minimum 1.
# OP_REGION_WORKER_MAX_NO_VERDICT_ATTEMPTS=3

# =============================================================================
# VLM endpoint registry and local model switching (W9)
# =============================================================================
# Whether crops may be sent to a VLM endpoint OUTSIDE this deployment (a
# hosted API, a public host). `ack` (default): allowed once the operator
# acknowledges the warning (registering the endpoint with allow_external, and
# activating it with acknowledge_external). `deny`: refused outright, for
# air-gapped or regulated deployments.
# OP_VLM_EXTERNAL_POLICY=ack
# Where secret references resolve (`secret:<slug>` -> <dir>/<slug>): a
# read-only mount of ./secrets/vlm. Rarely changed.
# OP_VLM_SECRETS_DIR=/run/secrets/op_vlm
# The name of the registered endpoint that reaches the in-compose vLLM (the
# installer writes `env`). Empty = no in-compose VLM to switch.
# OP_LOCAL_VLM_ENDPOINT=
# (OP_LOCAL_VLM_GPU_TOTAL_MIB, the card size for the catalog's `fits`, is set
# by compose from VLM_GPU_TOTAL_MIB below; a value here has no effect.)

# =============================================================================
# In-compose VLM (--profile vlm) — the `vlm` service in docker-compose.yml.
# Read by compose only (not the Python app); irrelevant if you point
# OP_VLM_URL at a VLM you already run elsewhere.
# =============================================================================
# Pin a real vLLM release tag; confirm it supports your model's multimodal
# (image) input before relying on it.
# VLM_IMAGE=vllm/vllm-openai:gemma4-cu130@sha256:0d152595cd940ea1e0890fa190a37b7a86e3f7f0f5048ac3e2e4c14529fea833
# VLM_MODEL=google/gemma-4-E4B-it
# VLM_SERVED_MODEL_NAME=gemma-4-e4b
# VLM_DTYPE=bfloat16
# VLM_MAX_MODEL_LEN=16384
# Must hold the largest call: the combined region batch asks for up to 6144
# output tokens on top of its prompt and one image-token block per crop
# (~267 tokens each for gemma-4-e4b), which does not fit in 8192 at 8 images.
# Fraction of the GPU's VRAM this service may claim. Share the GPU with
# Triton/the segmenter/training by lowering this -- e.g. an A6000 (48GB)
# running Triton (~10GB) + segmenter (~4GB) + this VLM at 0.30 (~14GB)
# leaves headroom; a 12-24GB card fits a smaller/quantized model instead.
# VLM_GPU_MEMORY_UTILIZATION=0.4
# COUPLING (G-10): this is vLLM's `--limit-mm-per-prompt` image cap -- the
# SERVER side of the same contract as OP_VLM_MAX_IMAGES_PER_CALL (the
# CLIENT side, above). They must be equal, or requests above the smaller
# one 400. Changing one without the other is the most common
# "VLM labeling returns 400s" misconfiguration.
# VLM_LIMIT_MM_IMAGES=8
# W9.7: model-specific vLLM flags, driven by examples/vlm/catalog.tsv and
# written by `openprocessor vlm use <id>`. UNSET keeps Gemma 4's parser and
# chat template; SET-but-empty (`VLM_REASONING_PARSER=`) drops the flag.
# VLM_REASONING_PARSER=gemma4
# VLM_CHAT_TEMPLATE=/vllm-workspace/examples/tool_chat_template_gemma4.jinja
# Extra vLLM arguments, appended as written (word-split).
# VLM_EXTRA_ARGS=
# The catalog entry the in-compose vLLM serves (informational; the CLI sets it).
# VLM_CATALOG_ID=gemma-4-e4b
# Total VRAM (MiB) of the VLM's card: lets the API show which catalog models fit.
# VLM_GPU_TOTAL_MIB=
# VLM_GPU_ID=0
# VLM_PORT is set (active, not commented) in the Port Configuration
# section above.

# =============================================================================
# Segmenter (SAM3-style) service — detection cascade's segmenter leg
# (scripts/curation/worker/client.py, src/services/detection/cascade_detect.py)
# =============================================================================
# Client side: where the detection worker looks for a segmenter. Empty
# (the default) makes the segmenter leg a no-op. Point it at the shipped
# `segmenter` service (`docker compose --profile segmenter up -d`) or at
# your own; OP_SEGMENTER_URLS takes a comma-separated list to load-balance.
# OP_SEGMENTER_URL=http://segmenter:8000
# OP_SEGMENTER_URLS=
# OP_SEGMENTER_HTTPX_MAX_CONNECTIONS=512
# OP_SEGMENTER_HTTPX_KEEPALIVE=128

# Server side: the shipped segmenter container (docker/segmenter/).
# HF_TOKEN is required — the SAM 3 weights are gated on HuggingFace.
# HF_TOKEN=
# SEGMENTER_DEVICE=cuda:0
# G-12: SEGMENTER_INSTANCES x model VRAM is the dominant cost unless
# SEGMENTER_SHARED_WEIGHTS=1 (all instances share one copy of the weights
# and only pay per-instance activation memory -- the recommended setting
# whenever VRAM is tight). See README "GPU sizing" for measured numbers
# per instance count; as a rule of thumb, start at 1-2 instances on a
# 12-24GB card and 2-4 on a 48GB card, shared weights on either way.
# SEGMENTER_INSTANCES=2
# SEGMENTER_SHARED_WEIGHTS=1
# SEGMENTER_COMPILE=0
# SEGMENTER_ENABLE_MASKS=1

# --- Projects (docs/design/openprocessor_internal/projects_plan.md) ---
# Isolated dataset workspaces. `default` is created at first boot exactly
# like any other project (indexes `op_prj_default__<role>`, data under
# OP_PROJECTS_DATA_ROOT/default); it can be archived, never deleted.
# These vars are read when a project is created and persisted in its record.
# OP_PROJECTS_INDEX=op_projects
# OP_PROJECT_INDEX_PREFIX=op_prj_
