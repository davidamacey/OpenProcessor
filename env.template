# =============================================================================
# OpenProcessor Configuration Template
# =============================================================================
# Copy this file to .env: cp env.template .env
# Or run ./scripts/setup.sh to auto-generate based on your GPU
# =============================================================================

# =============================================================================
# GPU Configuration
# =============================================================================

# GPU Profile (auto-detected during setup)
# Options:
#   minimal  - 6-8GB VRAM (RTX 3060, RTX 4060) - core models only
#   standard - 12-24GB VRAM (RTX 3080, RTX 4090) - all models
#   full     - 48GB+ VRAM (A6000, A100) - maximum parallelism
GPU_PROFILE=standard

# Which GPU to use (0-indexed)
# Use nvidia-smi to see available GPUs
GPU_ID=0

# =============================================================================
# Performance Settings (auto-configured based on GPU_PROFILE)
# =============================================================================

# Number of uvicorn workers for the FastAPI service
# Adjust based on CPU cores and memory
# Recommended: minimal=8, standard=16, full=32
TRITON_WORKERS=16

# Maximum batch size for inference
# Lower values use less VRAM but reduce throughput
# Recommended: minimal=16, standard=32, full=64
MAX_BATCH_SIZE=32

# Shared memory size for Docker containers
# Used for inter-process communication
# Recommended: minimal=4g, standard=6g, full=8g
SHM_SIZE=6g

# =============================================================================
# OpenSearch Vector Database
# =============================================================================

# JVM heap size for OpenSearch
# Affects search performance and memory usage
# Recommended: minimal=1g, standard=2g, full=4g
OPENSEARCH_HEAP=2g

# =============================================================================
# Port Configuration
# =============================================================================
# Change these if ports conflict with other services on your system

# Main API port (FastAPI service - all endpoints)
API_PORT=4603

# Triton Inference Server ports
TRITON_HTTP=4600
TRITON_GRPC=4601
TRITON_METRICS=4602

# Monitoring stack
PROMETHEUS_PORT=4604
GRAFANA_PORT=4605
LOKI_PORT=4606

# Vector database
OPENSEARCH_PORT=4607
OPENSEARCH_DASHBOARDS_PORT=4608

# =============================================================================
# Development Settings
# =============================================================================

# Enable debug mode (verbose logging)
# DEBUG=1

# Log level for uvicorn
# Options: critical, error, warning, info, debug, trace
# LOG_LEVEL=info

# =============================================================================
# Curation / Labeling Subsystem (CurationConfig — src/config/curation.py)
# =============================================================================
# All OP_* vars below are optional; unset vars fall back to the generic
# OSS defaults shown here (see CurationConfig.from_env()). A deployment
# with pre-existing data under different index/path names overrides only
# the vars it needs.
#
# IMPORTANT — import-time only: every curation router builds its prefix
# at *module import* (src/routers/curation/_common.py, curation_images.py,
# curation_train.py, curation_umap.py). OP_API_PREFIX (and any other
# OP_* var here) must be set in the process environment BEFORE src.main
# is imported — it cannot be changed at runtime once the app has started.

# OpenSearch index names
# OP_IMAGES_INDEX=op_images
# OP_ITEMS_INDEX=op_items
# OP_LABELS_CONFIRMED_INDEX=op_labels_confirmed
# OP_CLASSES_INDEX=op_classes
# OP_CLUSTERS_INDEX=op_clusters
# OP_SETTINGS_INDEX=op_curation_settings
# Two deliberately distinct UMAP-state indexes (see
# src/services/curation/embedding_viz.py module docstring): the retired
# clustering reducer's fitted-manifold cache, and the visualization-only
# projection's own run-metadata slot.
# OP_UMAP_STATE_INDEX=op_umap_state
# OP_UMAP_VIZ_STATE_INDEX=op_umap_viz_state

# Filesystem roots
# OP_REGISTRY_PATH=./data/class_registry.json
# OP_SOURCE_ROOT=./data/images
# OP_EXPORT_ROOT=./data/exports
# OP_STATE_DIR=/var/lib/openprocessor
# OP_CROP_CACHE_DIR=/dev/shm/openprocessor_crops

# Deployment-supplied VLM PromptPack (see data/prompt_pack.example.json and
# docs/design/curation_design_rationale.md). Unset (the default) uses the
# built-in generic pack -- no on-disk default to fall back to.
# OP_PROMPT_PACK_PATH=./data/prompt_pack.json

# HTTP API surface. /curation is the canonical generic prefix — this is
# NOT a place to set a deployment-specific historical prefix; see
# docs/design/cropwright_backend_integration_plan.md §0.1/§2.2.
# OP_API_PREFIX=/curation
# OP_API_TAG=Curation

# Embedding dimensions / HNSW index params
# OP_EMBEDDING_DIM=512
# OP_ENCODER_EMBEDDING_DIM=1024
# OP_BACKBONE_EMBEDDING_DIM=1024
# OP_HNSW_EF_CONSTRUCTION=512
# OP_HNSW_M=16

# Advanced: per-field OpenSearch key overrides for the region-of-interest
# sub-annotation (RegionFields — src/config/region_fields.py), for a
# deployment whose existing data lives under different field names.
# Pattern: OP_REGION_FIELD_<UPPERCASED_ATTR_NAME>, e.g.:
# OP_REGION_FIELD_STATUS=region_status
# OP_REGION_FIELD_BBOX_NORM=region_bbox_norm
# (see RegionFields dataclass for the full attribute list)

# Advanced: detection-cascade heuristics + Triton model wiring for one
# region-of-interest type (DetectionProfile — src/config/detection_profile.py).
# Pattern: OP_DETECTION_<UPPERCASED_FIELD_NAME>, e.g.:
# OP_DETECTION_NAME=license_plate
# OP_DETECTION_ASPECT_MIN=1.2
# OP_DETECTION_OCR_REC_MODEL=paddleocr_rec_trt
# (see DetectionProfile dataclass for the full field list; tuple/frozenset
# fields take a comma-separated value, e.g. OP_DETECTION_LETTERBOX_FILL=114,114,114)

# Curation ingest pipeline (src/services/curation/ingest.py). Note the
# ingest primary detector itself is configured via OP_DETECTION_* above
# (OP_DETECTION_DETECTOR_MODEL must name a Triton model that serves item
# proposals for this deployment — ingest 503s until one is set).
# OP_MAX_INGEST_CONCURRENCY=16

# =============================================================================
# Curation feature flags — capabilities gated off by default (experimental
# or awaiting a validation gate; see docs/design/curation_design_rationale.md)
# =============================================================================
# OP_SEMANTIC_SEARCH_ENABLED=1
# OP_VIZ_PROJECTION_ENABLED=1
# OP_SELECT_DIVERSE_ENABLED=1
# OP_SCORES_ENABLED=1
# OP_SCORES_SHADOW=1

# =============================================================================
# Curation item-scores tuning (src/services/curation/item_scores/)
# =============================================================================
# OP_SCORES_KNN_K=10
# OP_SCORES_NPROBE=8
# OP_SCORES_STATE_DIR=/jobs/scores
# OP_CROP_DUP_THRESHOLD=0.98
# OP_FIELD_COVERAGE_TTL_S=60

# =============================================================================
# Curation diverse-selection tuning (src/routers/curation/select.py,
# src/services/curation/selection/)
# =============================================================================
# OP_SELECT_JOBS_DIR=/jobs/select
# OP_SELECT_JOB_MAX_N=200000
# OP_SELECT_MAX_N=20000
# OP_SELECT_SYNC_MAX_OPS=3000000
# OP_SELECT_CACHE_TTL_S=600

# =============================================================================
# Curation clustering / IVF tuning (src/services/curation/clustering/)
# =============================================================================
# OP_IVF_RETRAIN_CHECK_S=1800
# OP_IVF_RETRAIN_GROWTH=1.5
# OP_IVF_RETRAIN_MIN_INTERVAL_S=86400
# OP_MAX_REFINE_MEMBERS=8000
# OP_OUTLIER_CACHE_TTL_S=600
# OP_OUTLIER_MAX_MEMBERS=20000
# OP_RESIDUAL_EMBEDDING_FIELD=pe_embedding
# OP_REGION_CLUSTER_JOB_FILE=/tmp/region_cluster_job.json
# OP_REGION_FP_JOB_FILE=/tmp/region_fp_job.json
# OP_REGION_PARTITION_MARKER=/tmp/region_partition_marker.json
# OP_REGION_REFINE_MARKER=/tmp/region_refine_marker.json

# =============================================================================
# Curation training pipeline (src/services/training/, src/routers/curation_train.py)
# =============================================================================
# OP_TRAIN_JOBS_DIR=/jobs
# OP_TRAIN_RUNS_ROOT=/var/lib/openprocessor/training_runs
# OP_TRAIN_STAGING=/var/lib/openprocessor/training_staging
# OP_PREFLIGHT_SCAN_CAP=200000

# ---- Trainer container only (docker/trainer/, profile `training`) -----------
# Scratch root for per-job subset/augmentation rewrites. Always cleaned up at
# job end; inside the container this is a tmpfs.
# OP_TRAIN_TMP_ROOT=/tmp
# Host GPU ids the trainer container is attached to, in the SAME order as the
# compose service's `device_ids`. job.json names host ids; inside a container
# pinned to a GPU subset they appear as positional local indices. Leave unset
# when the container sees every GPU at its host index.
# OP_TRAIN_GPU_ORDER=0
# Class names whose content is orientation-sensitive (text, digits, signage).
# Horizontal flip is disabled for any run that trains one of them. Matched
# case-insensitively against the training data.yaml's `names`. Per-job
# override: job.json's `augmentation.text_class_names`.
# OP_TRAIN_TEXT_CLASS_NAMES=
# Triton models to compare a finished run against, in preference order; the
# first one Triton reports READY wins. Unset (default) skips the comparison
# and leaves status.compare null.
# OP_TRAIN_INCUMBENT_MODELS=
# OP_TRAIN_COMPARE_MAX_IMAGES=200
# OP_TRAIN_COMPARE_INPUT_SIZE=640
# Triton model repository, if mounted into the trainer — used only to read an
# incumbent's labels.txt so comparison rows carry names, not bare ids.
# OP_TRITON_MODEL_REPO=/models
# OP_TRITON_HTTP_URL=http://triton-server:8000
# API base the trainer POSTs a campaign's auto-promote to (joined with
# OP_API_PREFIX).
# OP_API_BASE_URL=http://yolo-api:8000
# Image digest recorded in each run manifest's code_versions block.
# OP_TRAINER_IMAGE_DIGEST=
# OP_TRAIN_LOG_LEVEL=INFO
# MLflow (optional; every hook degrades to a warning when unreachable).
# MLFLOW_TRACKING_URI=http://curation-mlflow:5000
# MLFLOW_EXPERIMENT_NAME=openprocessor
# OP_MLFLOW_MODEL_NAME=openprocessor_detector
# OP_MLFLOW_CONFUSION_MATRIX_EVERY=25

# GPU arbiter (src/config/gpu_arbiter.py — GpuArbiterConfig.from_env).
# Comma-separated GPU ids a training / bake-off job may target; any other id
# is rejected at job submission. Unset/empty = unrestricted (any id).
# OP_GPU_ALLOWED_IDS=0,2
# Containers stopped (in order) while a run holds the GPUs and restarted
# when it releases them. Unset/empty = no container coordination.
# OP_GPU_ARBITER_CONTAINERS=
# Trainer container probed for reachability before a run starts.
# Unset/empty = skip the probe.
# OP_GPU_ARBITER_TRAINER_CONTAINER=
# (The arbiter's bake-off queue dir is OP_BAKEOFF_JOBS_DIR, below.)

# =============================================================================
# Curation export (src/services/curation/export.py)
# =============================================================================
# Overrides the manifest's recorded code SHA when the container image was
# built outside a git checkout (no .git dir to `git rev-parse HEAD` from) —
# set at image-build time to the real commit sha baked into that image.
# OP_BUILD_SHA=

# =============================================================================
# Curation bake-off harness (src/routers/curation/bakeoff.py,
# scripts/curation/bakeoff/) — see CurationConfig.bakeoff_eval_root
# =============================================================================
# OP_BAKEOFF_JOBS_DIR=/var/lib/openprocessor/bakeoff_jobs
# OP_BAKEOFF_OUT_DIR=/var/lib/openprocessor/bakeoff_out
# OP_BAKEOFF_EVAL_ROOT=./data/bakeoff_eval
# OP_BAKEOFF_CONCURRENCY=4
# OP_BAKEOFF_GPUS=0
# OP_COREML_HOST=user@host.local

# =============================================================================
