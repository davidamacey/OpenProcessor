# =============================================================================
# OpenProcessor Configuration Template
# =============================================================================
# Copy this file to .env: cp env.template .env
# Or run ./scripts/setup.sh to auto-generate based on your GPU
# =============================================================================

# =============================================================================
# GPU Configuration
# =============================================================================

# GPU Profile (auto-detected during setup)
# Options:
#   minimal  - 6-8GB VRAM (RTX 3060, RTX 4060) - core models only
#   standard - 12-24GB VRAM (RTX 3080, RTX 4090) - all models
#   full     - 48GB+ VRAM (A6000, A100) - maximum parallelism
GPU_PROFILE=standard

# Which GPU to use (0-indexed)
# Use nvidia-smi to see available GPUs
GPU_ID=0

# =============================================================================
# Performance Settings (auto-configured based on GPU_PROFILE)
# =============================================================================

# Number of uvicorn workers for the FastAPI service
# Adjust based on CPU cores and memory
# Recommended: minimal=8, standard=16, full=32
TRITON_WORKERS=16

# Maximum batch size for inference
# Lower values use less VRAM but reduce throughput
# Recommended: minimal=16, standard=32, full=64
MAX_BATCH_SIZE=32

# Shared memory size for Docker containers
# Used for inter-process communication
# Recommended: minimal=4g, standard=6g, full=8g
SHM_SIZE=6g

# =============================================================================
# OpenSearch Vector Database
# =============================================================================

# JVM heap size for OpenSearch
# Affects search performance and memory usage
# Recommended: minimal=1g, standard=2g, full=4g
OPENSEARCH_HEAP=2g

# =============================================================================
# Port Configuration
# =============================================================================
# Change these if ports conflict with other services on your system

# Main API port (FastAPI service - all endpoints)
API_PORT=4603

# Triton Inference Server ports
TRITON_HTTP=4600
TRITON_GRPC=4601
TRITON_METRICS=4602

# Monitoring stack
PROMETHEUS_PORT=4604
GRAFANA_PORT=4605
LOKI_PORT=4606

# Vector database
OPENSEARCH_PORT=4607
OPENSEARCH_DASHBOARDS_PORT=4608

# =============================================================================
# Development Settings
# =============================================================================

# Enable debug mode (verbose logging)
# DEBUG=1

# Log level for uvicorn
# Options: critical, error, warning, info, debug, trace
# LOG_LEVEL=info

# =============================================================================
# Curation / Labeling Subsystem (CurationConfig — src/config/curation.py)
# =============================================================================
# All OP_* vars below are optional; unset vars fall back to the generic
# OSS defaults shown here (see CurationConfig.from_env()). A deployment
# with pre-existing data under different index/path names overrides only
# the vars it needs.
#
# IMPORTANT — import-time only: every curation router builds its prefix
# at *module import* (src/routers/curation/_common.py, curation_images.py,
# curation_train.py, curation_umap.py). OP_API_PREFIX (and any other
# OP_* var here) must be set in the process environment BEFORE src.main
# is imported — it cannot be changed at runtime once the app has started.

# OpenSearch index names
# OP_IMAGES_INDEX=op_images
# OP_ITEMS_INDEX=op_items
# OP_LABELS_CONFIRMED_INDEX=op_labels_confirmed
# OP_CLASSES_INDEX=op_classes
# OP_CLUSTERS_INDEX=op_clusters
# OP_SETTINGS_INDEX=op_curation_settings
# Two deliberately distinct UMAP-state indexes (see
# src/services/curation/embedding_viz.py module docstring): the retired
# clustering reducer's fitted-manifold cache, and the visualization-only
# projection's own run-metadata slot.
# OP_UMAP_STATE_INDEX=op_umap_state
# OP_UMAP_VIZ_STATE_INDEX=op_umap_viz_state

# Filesystem roots
# OP_REGISTRY_PATH=./data/class_registry.json
# OP_SOURCE_ROOT=./data/images
# Named extra source roots, served at GET {prefix}/images/root/{alias}?path=...
# and matched by leading path segment for relative paths. JSON object or
# comma-separated alias=path list. Unset = no aliases.
# OP_SOURCE_PATH_ALIASES=archive=/data/archive,nightly=/data/nightly
# OP_EXPORT_ROOT=./data/exports
# OP_STATE_DIR=/var/lib/openprocessor
# OP_CROP_CACHE_DIR=/dev/shm/openprocessor_crops

# Deployment-supplied VLM PromptPack (see data/prompt_pack.example.json and
# docs/design/curation_design_rationale.md). Unset (the default) uses the
# built-in generic pack -- no on-disk default to fall back to.
# OP_PROMPT_PACK_PATH=./data/prompt_pack.json
# Additional selectable prompt packs (comma-separated JSON files). Each is
# advertised on GET /methods axis=prompt_pack by its `name`, alongside the
# built-in generic pack and the OP_PROMPT_PACK_PATH pack (the default), and
# can be chosen via the settings default or per auto-label run
# (?prompt_pack=<name>). Unloadable files are skipped with a warning.
# OP_PROMPT_PACK_PATHS=./data/prompt_pack_a.json,./data/prompt_pack_b.json

# HTTP API surface. /curation is the canonical generic prefix — this is
# NOT a place to set a deployment-specific historical prefix; see
# docs/design/cropwright_backend_integration_plan.md §0.1/§2.2.
# OP_API_PREFIX=/curation
# OP_API_TAG=Curation

# Embedding dimensions / HNSW index params
# OP_EMBEDDING_DIM=512
# OP_ENCODER_EMBEDDING_DIM=1024
# OP_BACKBONE_EMBEDDING_DIM=1024
# OP_HNSW_EF_CONSTRUCTION=512
# OP_HNSW_M=16

# Advanced: per-field OpenSearch key overrides for the region-of-interest
# sub-annotation (RegionFields — src/config/region_fields.py), for a
# deployment whose existing data lives under different field names.
# Pattern: OP_REGION_FIELD_<UPPERCASED_ATTR_NAME>, e.g.:
# OP_REGION_FIELD_STATUS=region_status
# OP_REGION_FIELD_BBOX_NORM=region_bbox_norm
# (see RegionFields dataclass for the full attribute list)

# Region-of-interest detection profile (the detection worker's region
# cascade; src/services/detection/profile_registry.py). NEUTRAL BY DEFAULT:
# with neither var below set, no region profile is active, GET /methods
# advertises no detection_profile, and region detection is off (the worker
# idles). Select a registered or built-in reference profile by name
# (built-in: license_plate) -- an unknown name fails at startup:
# OP_REGION_PROFILE=license_plate
# Per-field overrides on top of the selected profile (or, with no
# OP_REGION_PROFILE, a profile built from the DetectionProfile defaults).
# Pattern: OP_REGION_DETECTION_<UPPERCASED_FIELD_NAME>, e.g.:
# OP_REGION_DETECTION_NAME=shipping_label
# OP_REGION_DETECTION_DETECTOR_MODEL=label_detector
# OP_REGION_DETECTION_SAM_TEXT_PROMPT=shipping label
# OP_REGION_DETECTION_SECONDARY_SHAPE_GROUPS=group_a,group_b
# The segmenter leg needs a non-empty SAM_TEXT_PROMPT; without one it is
# disabled even when SAM3_URL is set.

# Ingest item detectors (DetectionProfile — src/config/detection_profile.py,
# read by routers/curation/ingest.py). Separate namespaces from the region
# profile above; the retired OP_DETECTION_* prefix is rejected loudly.
# Primary: an end2end (already-NMS'd) item proposer. Required for ingest.
# Pattern: OP_INGEST_PRIMARY_<UPPERCASED_FIELD_NAME>, e.g.:
# OP_INGEST_PRIMARY_DETECTOR_MODEL=yolov11_small_trt_end2end
# OP_INGEST_PRIMARY_INPUT_SIZE=640
# OP_INGEST_PRIMARY_CONFIDENCE_FLOOR=0.4
# Only these model class ids become items (comma list; unset = all classes):
# OP_INGEST_PRIMARY_CLASS_IDS=2,3,5,7
# Is the primary's label space the class registry itself? false (default):
# it is a generic proposer -- its detections are always unlabeled proposals
# (class_source "<name>_proposal", no class_id) and the secondary / VLM /
# human assigns the class. true: confident detections take the registry
# class with the same id (class_source "<name>_model").
# OP_INGEST_PRIMARY_ASSIGNS_CLASS=false
# The proposer's own labels (labels.txt, line index = class id), recorded
# as each item's proposal name. Unset = the bare class id.
# OP_INGEST_PRIMARY_LABELS_PATH=/models/yolov11_small_trt_end2end/labels.txt
# OP_INGEST_PRIMARY_NAME=item
# Secondary (optional): a raw-output ensemble detector (single `output0`,
# client-side NMS) whose hits override the primary's class on IoU-matched
# boxes. Off unless OP_INGEST_SECONDARY_DETECTOR_MODEL is set. Its NAME
# prefixes the class_source it writes ("<name>_model"; default "secondary").
# OP_INGEST_SECONDARY_DETECTOR_MODEL=
# OP_INGEST_SECONDARY_DETECTOR_VERSION=1
# OP_INGEST_SECONDARY_INPUT_SIZE=640
# OP_INGEST_SECONDARY_CONFIDENCE_FLOOR=0.4
# OP_INGEST_SECONDARY_NAME=secondary
# (see DetectionProfile for the full field list; tuple/frozenset fields take
# a comma-separated value, e.g. OP_INGEST_PRIMARY_LETTERBOX_FILL=114,114,114)

# Curation ingest pipeline (src/services/curation/ingest.py). The ingest
# primary detector itself is configured via OP_INGEST_PRIMARY_* above
# (ingest 503s until OP_INGEST_PRIMARY_DETECTOR_MODEL is set).
# OP_MAX_INGEST_CONCURRENCY=16

