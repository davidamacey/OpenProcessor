# =============================================================================
# OpenProcessor Configuration Template
# =============================================================================
# Copy this file to .env: cp env.template .env
# Or run ./scripts/setup.sh to auto-generate based on your GPU
# =============================================================================

# =============================================================================
# GPU Configuration
# =============================================================================

# GPU Profile (auto-detected during setup)
# Options:
#   minimal  - 6-8GB VRAM (RTX 3060, RTX 4060) - core models only
#   standard - 12-24GB VRAM (RTX 3080, RTX 4090) - all models
#   full     - 48GB+ VRAM (A6000, A100) - maximum parallelism
GPU_PROFILE=standard

# Which GPU to use (0-indexed)
# Use nvidia-smi to see available GPUs
GPU_ID=0

# =============================================================================
# Performance Settings (auto-configured based on GPU_PROFILE)
# =============================================================================

# Number of uvicorn workers for the FastAPI service
# Adjust based on CPU cores and memory
# Recommended: minimal=8, standard=16, full=32
TRITON_WORKERS=16

# Maximum batch size for inference
# Lower values use less VRAM but reduce throughput
# Recommended: minimal=16, standard=32, full=64
MAX_BATCH_SIZE=32

# Shared memory size for Docker containers
# Used for inter-process communication
# Recommended: minimal=4g, standard=6g, full=8g
SHM_SIZE=6g

# =============================================================================
# OpenSearch Vector Database
# =============================================================================

# JVM heap size for OpenSearch
# Affects search performance and memory usage
# Recommended: minimal=1g, standard=2g, full=4g
OPENSEARCH_HEAP=2g

# =============================================================================
# Image repo / tag (F-01) -- isolate a second clone's local build
# =============================================================================
# Every built service's `image:` in docker-compose.yml interpolates from
# these two vars. A stock clone's default (repo `davidamacey`, tag `latest`)
# is what the published images use, but it also means `docker compose build`
# in a second, unrelated clone on the same host silently retags the local
# `:latest` that a DIFFERENT running stack's containers reference -- the
# next `up`/restart of that other stack then picks up the foreign build.
# Give any second clone (dev branch, fresh-install rehearsal, etc.) its own
# tag so builds can never cross-contaminate:
# OP_IMAGE_REPO=davidamacey
# OP_IMAGE_TAG=latest

# =============================================================================
# Isolation (G-01) -- run a second, independent stack on the same host
# =============================================================================
# Every service's container_name, and every host port below, is
# interpolated from these vars (see docker-compose.yml). Set
# COMPOSE_PROJECT_NAME (and re-map any port that collides with an
# existing stack) to bring up a second OpenProcessor on the same host --
# it gets its own container names, network and volumes automatically.
# Leaving this unset keeps today's single-stack behavior (project name
# `openprocessor`, container names like `yolo-api`/`triton-server`).
# COMPOSE_PROJECT_NAME=opfresh

# =============================================================================
# Port Configuration
# =============================================================================
# Change these if ports conflict with other services on your system.
# `make` also reads this file (see Makefile's `-include .env`), so
# `make up`, `make test-detect`, etc. target the same ports without
# re-typing them on every invocation.

# Main API port (FastAPI service - all endpoints)
API_PORT=4603

# Triton Inference Server ports
TRITON_HTTP_PORT=4600
TRITON_GRPC_PORT=4601
TRITON_METRICS_PORT=4602
# GPU id Triton runs on
TRITON_GPU_ID=0
# F-2 (fresh-start E2E findings 2026-09-25): yolo-api (PE/MobileCLIP torch
# fallback + CUDA-side preprocessing), curation-evaluator and segmenter
# used to hardcode device_ids: ['0'] regardless of where Triton/VLM ran.
# On a host whose free GPU isn't 0, change these three (docker-compose.yml
# does its own `${VAR:-default}` interpolation -- .env values are NOT
# shell-expanded, so this can't just reference GPU_ID above; set each
# explicitly if it needs to differ from 0).
API_GPU_ID=0
EVALUATOR_GPU_ID=0
SEGMENTER_GPU_ID=0

# Monitoring stack
PROMETHEUS_PORT=4604
GRAFANA_PORT=4605
LOKI_PORT=4606
# DCGM GPU metrics exporter
DCGM_PORT=4610

# Vector database
OPENSEARCH_PORT=4607
OPENSEARCH_DASHBOARDS_PORT=4608

# Training pipeline (--profile training)
MLFLOW_PORT=4609

# Segmenter (--profile segmenter)
SEGMENTER_PORT=4611

# In-compose VLM (--profile vlm)
VLM_PORT=4612

# =============================================================================
# Development Settings
# =============================================================================

# Enable debug mode (verbose logging)
# DEBUG=1

# Log level for uvicorn
# Options: critical, error, warning, info, debug, trace
# LOG_LEVEL=info

# =============================================================================
# Curation / Labeling Subsystem (CurationConfig — src/config/curation.py)
# =============================================================================
# All OP_* vars below are optional; unset vars fall back to the generic
# OSS defaults shown here (see CurationConfig.from_env()). A deployment
# with pre-existing data under different index/path names overrides only
# the vars it needs.
#
# IMPORTANT — import-time only: every curation router builds its prefix
# at *module import* (src/routers/curation/_common.py, curation_images.py,
# curation_train.py, curation_umap.py). OP_API_PREFIX (and any other
# OP_* var here) must be set in the process environment BEFORE src.main
# is imported — it cannot be changed at runtime once the app has started.

# OpenSearch index names
# OP_IMAGES_INDEX=op_images
# OP_ITEMS_INDEX=op_items
# OP_LABELS_CONFIRMED_INDEX=op_labels_confirmed
# OP_CLASSES_INDEX=op_classes
# OP_CLUSTERS_INDEX=op_clusters
# OP_SETTINGS_INDEX=op_curation_settings
# Two deliberately distinct UMAP-state indexes (see
# src/services/curation/embedding_viz.py module docstring): the retired
# clustering reducer's fitted-manifold cache, and the visualization-only
# projection's own run-metadata slot.
# OP_UMAP_STATE_INDEX=op_umap_state
# OP_UMAP_VIZ_STATE_INDEX=op_umap_viz_state

# Filesystem roots
# OP_REGISTRY_PATH=./data/class_registry.json
# G-06: the in-container path yolo-api resolves source-relative item
# paths against -- MUST match the bind target on both yolo-api and
# curation-detection-worker (docker-compose.yml mounts
# ${OP_SOURCE_ROOT_HOST:-./data/source}:/data/source:ro on both; see
# docs/CURATION.md "Mounting your image source"). Set OP_SOURCE_ROOT_HOST
# to point the bind at wherever your images actually live on the host --
# OP_SOURCE_ROOT itself normally stays at the container-side default.
# OP_SOURCE_ROOT=/data/source
# OP_SOURCE_ROOT_HOST=./data/source
# Named extra source roots, served at GET {prefix}/images/root/{alias}?path=...
# and matched by leading path segment for relative paths. JSON object or
# comma-separated alias=path list. Unset = no aliases.
# OP_SOURCE_PATH_ALIASES=archive=/data/archive,nightly=/data/nightly
# OP_EXPORT_ROOT=./data/exports
# ST-4: keep-last retention for auto-named (timestamped) export dirs under
# OP_EXPORT_ROOT, applied best-effort after each successful export. Never
# touches a custom-named export dir, the `current` symlink's target, or a
# dir any job/run/bake-off still references. 0 = keep all.
# OP_EXPORT_KEEP_LAST=5
# OP_STATE_DIR=/var/lib/openprocessor
# OP_CROP_CACHE_DIR=/dev/shm/openprocessor_crops
# ST-1: prune the crop cache back toward 90% of this cap once exceeded
# (checked every ~256 ingest writes, not on every single one). 0 disables
# pruning. Default matches the crop_cache volume's tmpfs headroom.
# OP_CROP_CACHE_MAX_BYTES=3221225472

# Deployment-supplied VLM PromptPack (see data/prompt_pack.example.json and
# docs/design/curation_design_rationale.md). Unset (the default) uses the
# built-in generic pack -- no on-disk default to fall back to.
# OP_PROMPT_PACK_PATH=./data/prompt_pack.json
# Additional selectable prompt packs (comma-separated JSON files). Each is
# advertised on GET /methods axis=prompt_pack by its `name`, alongside the
# built-in generic pack and the OP_PROMPT_PACK_PATH pack (the default), and
# can be chosen via the settings default or per auto-label run
# (?prompt_pack=<name>). Unloadable files are skipped with a warning.
# OP_PROMPT_PACK_PATHS=./data/prompt_pack_a.json,./data/prompt_pack_b.json

# New-class proposal term rules (GET /review/new_class_proposals/summary).
# Proposed names matching these are served under flagged_terms instead of
# being offered as a new class. Comma-separated; empty by default (registry
# group names and existing class names are always flagged).
# Whole-name matches: generic parents of existing classes.
# OP_NEW_CLASS_GENERIC_TERMS=vehicle,object
# Whole-name or single-token matches: not an object at all.
# OP_NEW_CLASS_NON_OBJECT_TERMS=blur,blurry,empty,scene

# HTTP API surface. /curation is the canonical generic prefix — this is
# NOT a place to set a deployment-specific historical prefix.
# OP_API_PREFIX=/curation
# OP_API_TAG=Curation

# BA-1/BA-2/BA-5: byte-upload ingest (POST /ingest/upload) persistence +
# request limits, served typed on GET /curation/ingest/config.
# OP_UPLOAD_ROOT=/var/lib/openprocessor/uploads
# OP_UPLOAD_MAX_IMAGES_PER_REQUEST=128
# OP_UPLOAD_MAX_BYTES_PER_REQUEST=536870912
# OP_UPLOAD_ACCEPTED_EXTENSIONS=.jpg,.jpeg,.png
# OP_BATCH_MAX_ITEMS_PER_REQUEST=512

# BA-3: /ingest/region_drain's server-computed stability verdict
# parameters (also served on GET /curation/ingest/config). The streak
# (zero_since / how many consecutive zero-reading polls) is persisted to
# a small state.json under OP_REGION_DRAIN_STATE_DIR (shared /jobs volume,
# same convention as the job-runner modules) -- multiple yolo-api
# --workers processes answer this poll at random, so the streak can't
# live in module memory or it resets every time a different worker
# answers.
# OP_REGION_DRAIN_POLL_INTERVAL_S=10
# OP_REGION_DRAIN_STABLE_POLLS=3
# OP_REGION_DRAIN_STATE_DIR=/jobs/region_drain

# Embedding dimensions / HNSW index params
# OP_EMBEDDING_DIM=512
# OP_ENCODER_EMBEDDING_DIM=1024
# OP_BACKBONE_EMBEDDING_DIM=1024
# OP_HNSW_EF_CONSTRUCTION=512
# OP_HNSW_M=16

# Advanced: per-field OpenSearch key overrides for the region-of-interest
# sub-annotation (RegionFields — src/config/region_fields.py), for a
# deployment whose existing data lives under different field names.
# Pattern: OP_REGION_FIELD_<UPPERCASED_ATTR_NAME>, e.g.:
# OP_REGION_FIELD_STATUS=region_status
# OP_REGION_FIELD_BBOX_NORM=region_bbox_norm
# (see RegionFields dataclass for the full attribute list)

# Region-of-interest detection profile (the detection worker's region
# cascade; src/services/detection/profile_registry.py). NEUTRAL BY DEFAULT:
# with none of the vars below set, no region profile is active, GET /methods
# advertises no detection_profile, and region detection is off (the worker
# idles). No profile ships built in -- load one from a JSON file (see
# examples/region_profiles/ for a worked example) or select a profile a
# deployment's own startup code registered by name. G-08: this path is
# read INSIDE the container -- docker-compose.yml mounts the repo's
# ./examples at /app/examples:ro on yolo-api and
# curation-detection-worker, so a host-relative path like
# "examples/region_profiles/..." resolves to nothing in either
# container.
# OP_REGION_PROFILE_PATH=/app/examples/region_profiles/license_plate.json
# OP_REGION_PROFILE=<name-a-deployment-registered>  (an unknown name fails at startup)
# Per-field overrides on top of the selected profile (or, with no
# OP_REGION_PROFILE, a profile built from the DetectionProfile defaults).
# Pattern: OP_REGION_DETECTION_<UPPERCASED_FIELD_NAME>, e.g.:
# OP_REGION_DETECTION_NAME=shipping_label
# OP_REGION_DETECTION_DETECTOR_MODEL=label_detector
# OP_REGION_DETECTION_SEGMENTER_TEXT_PROMPT=shipping label
# OP_REGION_DETECTION_SECONDARY_SHAPE_GROUPS=group_a,group_b
# The segmenter leg needs a non-empty SEGMENTER_TEXT_PROMPT; without one it is
# disabled even when OP_SEGMENTER_URL is set.
# Region text reader (src/services/detection/region_text.py): which reader
# fills region_text -- vlm | ocr | vlm_then_ocr (default) | both. With no VLM
# URL configured (OP_VLM_URL unset) the worker accepts detector regions
# unverified and reads their text by OCR.
# The dominant-text rules are OP_REGION_DETECTION_TEXT_* fields, e.g.:
# OP_REGION_DETECTION_TEXT_READER=vlm_then_ocr
# OP_REGION_DETECTION_TEXT_MIN_HEIGHT_RATIO=0.6
# OP_REGION_DETECTION_TEXT_BORDER_MARGIN=0.08
# OP_REGION_DETECTION_TEXT_CHARSET=[A-Z0-9]
# OP_REGION_DETECTION_TEXT_STOPWORDS=word_a,word_b
# Which readings count as text at all (src/services/detection/region_text_rules.py):
# a reading failing these is no reading, and the other reader's valid reading
# is chosen instead. The prompt pack's quoted example values are always
# placeholders; add retired ones here.
# OP_REGION_DETECTION_TEXT_FORMAT=[A-Z0-9]{2,10}
# OP_REGION_DETECTION_TEXT_PLACEHOLDERS=example_a,example_b
# OP_REGION_DETECTION_TEXT_REJECT_SEQUENCES=true

# Searchable per-item text: the detection worker stores every OCR line read
# on the item crop (item_text_lines / item_text_tokens; GET /crops?item_text=).
# Effective only when the region profile names an OCR pipeline model.
# OP_ITEM_TEXT_ENABLED=true
# Lines below this recognition score are not stored.
# OP_ITEM_TEXT_MIN_CONFIDENCE=0.5

# Ingest item detectors (DetectionProfile — src/config/detection_profile.py,
# read by routers/curation/ingest.py). Separate namespaces from the region
# profile above; the retired OP_DETECTION_* prefix is rejected loudly.
# Primary: an end2end (already-NMS'd) item proposer. Required for ingest.
# Pattern: OP_INGEST_PRIMARY_<UPPERCASED_FIELD_NAME>, e.g.:
# OP_INGEST_PRIMARY_DETECTOR_MODEL=yolov11_small_trt_end2end
# OP_INGEST_PRIMARY_INPUT_SIZE=640
# OP_INGEST_PRIMARY_CONFIDENCE_FLOOR=0.4
# Only these model class ids become items (comma list; unset = all classes):
# OP_INGEST_PRIMARY_CLASS_IDS=2,3,5,7
# Is the primary's label space the class registry itself? false (default):
# it is a generic proposer -- its detections are always unlabeled proposals
# (class_source "<name>_proposal", no class_id) and the secondary / VLM /
# human assigns the class. true: confident detections take the registry
# class with the same id (class_source "<name>_model").
# OP_INGEST_PRIMARY_ASSIGNS_CLASS=false
# The proposer's own labels (labels.txt, line index = class id), recorded
# as each item's proposal name. Unset = the bare class id.
# OP_INGEST_PRIMARY_LABELS_PATH=/app/models/yolov11_small_trt_end2end/labels.txt
# OP_INGEST_PRIMARY_NAME=item
# Secondary (optional): a raw-output ensemble detector (single `output0`,
# client-side NMS) whose hits override the primary's class on IoU-matched
# boxes. Off unless OP_INGEST_SECONDARY_DETECTOR_MODEL is set. Its NAME
# prefixes the class_source it writes ("<name>_model"; default "secondary").
# OP_INGEST_SECONDARY_DETECTOR_MODEL=
# OP_INGEST_SECONDARY_DETECTOR_VERSION=1
# OP_INGEST_SECONDARY_INPUT_SIZE=640
# OP_INGEST_SECONDARY_CONFIDENCE_FLOOR=0.4
# OP_INGEST_SECONDARY_NAME=secondary
# (see DetectionProfile for the full field list; tuple/frozenset fields take
# a comma-separated value, e.g. OP_INGEST_PRIMARY_LETTERBOX_FILL=114,114,114)

# Curation ingest pipeline (src/services/curation/ingest.py). The ingest
# primary detector itself is configured via OP_INGEST_PRIMARY_* above
# (ingest 503s until OP_INGEST_PRIMARY_DETECTOR_MODEL is set).
# OP_MAX_INGEST_CONCURRENCY=16

# =============================================================================
# Curation feature flags — capabilities gated off by default (experimental
# or awaiting a validation gate; see docs/design/curation_design_rationale.md)
# =============================================================================
# OP_SEMANTIC_SEARCH_ENABLED=1
#
# PE-Core text encoder behind semantic search (src/clients/pe_encoder.py).
# Backend: auto (default) = in-process ONNX Runtime if OP_PE_TEXT_ONNX_PATH
# exists, else Triton's OP_PE_TEXT_TRITON_MODEL if ready, else PyTorch eager.
# Pin with onnx | triton | torch. Export the graph with
# export/export_pe_text_encoder.py (see export/README.md).
# OP_PE_TEXT_BACKEND=auto
# OP_PE_TEXT_ONNX_PATH=/app/pytorch_models/pe_text_encoder.onnx
# OP_PE_TEXT_TRITON_MODEL=pe_text_encoder
# ONNX Runtime intra-op threads (default: ORT's choice = physical cores)
# OP_PE_TEXT_ORT_THREADS=8
# OP_VIZ_PROJECTION_ENABLED=1
# OP_SELECT_DIVERSE_ENABLED=1
#
# Region embeddings written live by the detection worker at flush time
# (scripts/curation/worker/region_embed_stage.py) -- region-FP clustering
# and GET /regions/suspected_false_positives both key off this field.
# Default on; the worker auto-disables it (with a warning, once at
# startup) if pe_image_encoder isn't READY on Triton. Items written before
# this stage existed (or while it was disabled) still need
# scripts/curation/backfill_region_embeddings.py.
# OP_REGION_EMBED_ENABLED=true
# OP_SCORES_ENABLED=1
# OP_SCORES_SHADOW=1

# =============================================================================
# Curation item-scores tuning (src/services/curation/item_scores/)
# =============================================================================
# OP_SCORES_KNN_K=10
# OP_SCORES_NPROBE=8
# OP_SCORES_STATE_DIR=/jobs/scores
# OP_CROP_DUP_THRESHOLD=0.98
# OP_FIELD_COVERAGE_TTL_S=60

# =============================================================================
# C1 active-learning probe job (src/services/curation/probe_job.py,
# POST/GET /curation/probe/*). File-backed state.json/heartbeat/cancel.flag
# on the shared /jobs volume -- every yolo-api --workers process reads and
# writes the same files, so status/cancel/singleton-start are all correct
# regardless of which worker process a given request lands on.
# =============================================================================
# OP_PROBE_JOBS_DIR=/jobs/probe
# Confidence floor gating the item wire's `probe_actionable` field (see
# src.services.curation.wire.probe_actionable and
# docs/design/curation_api_contract.md). `probe_actionable` is only true
# when the probe disagrees with the item's current class AND its top-1
# posterior (`probe_pred_confidence`) is at least this floor -- a
# disagreeing-but-unsure probe (near-uniform posterior) must not offer a
# one-click "accept model's class". Confidence, not `probe_pred_entropy`,
# gates this: entropy is a raw Shannon value in nats bounded by
# `log(nc)`, where `nc` (the probe checkpoint's class count) varies by
# deployment and isn't stored per item, so a fixed threshold against it
# would drift; `probe_pred_confidence` is always in [0, 1] by
# construction and written alongside `probe_pred_class`. Read-only echo
# on GET /curation/probe/status as `actionable_min_confidence`.
# OP_PROBE_ACTIONABLE_MIN_CONFIDENCE=0.5

# =============================================================================
# Curation diverse-selection tuning (src/routers/curation/select.py,
# src/services/curation/selection/)
# =============================================================================
# OP_SELECT_JOBS_DIR=/jobs/select
# OP_SELECT_JOB_MAX_N=200000
# OP_SELECT_MAX_N=20000
# OP_SELECT_SYNC_MAX_OPS=3000000
# OP_SELECT_CACHE_TTL_S=600

# =============================================================================
# Curation clustering / IVF tuning (src/services/curation/clustering/)
# =============================================================================
# OP_IVF_RETRAIN_CHECK_S=1800
# OP_IVF_RETRAIN_GROWTH=1.5
# OP_IVF_RETRAIN_MIN_INTERVAL_S=86400
# OP_MAX_REFINE_MEMBERS=8000
# OP_OUTLIER_CACHE_TTL_S=600
# OP_OUTLIER_MAX_MEMBERS=20000
# OP_RESIDUAL_EMBEDDING_FIELD=pe_embedding
# OP_REGION_CLUSTER_JOB_FILE=/tmp/region_cluster_job.json
# OP_REGION_FP_JOB_FILE=/tmp/region_fp_job.json
# OP_REGION_PARTITION_MARKER=/tmp/region_partition_marker.json
# OP_REGION_REFINE_MARKER=/tmp/region_refine_marker.json

# =============================================================================
# Curation training pipeline (src/services/training/, src/routers/curation_train.py)
# =============================================================================
# OP_TRAIN_JOBS_DIR=/jobs
# OP_TRAIN_RUNS_ROOT=/var/lib/openprocessor/training_runs
# OP_TRAIN_STAGING=/var/lib/openprocessor/training_staging
# OP_PREFLIGHT_SCAN_CAP=200000
# Deployment-specific class-subset presets appended to GET /curation/train/presets
# (a JSON list of {name, label, description, selector, [single_cls_default]}).
# OP_TRAIN_PRESETS_PATH=

# ---- Trainer container only (docker/trainer/, profile `training`) -----------
# Scratch root for per-job subset/augmentation rewrites. Always cleaned up at
# job end; inside the container this is a tmpfs.
# OP_TRAIN_TMP_ROOT=/tmp
# Host GPU ids the trainer container is attached to, in the SAME order as the
# compose service's `device_ids`. job.json names host ids; inside a container
# pinned to a GPU subset they appear as positional local indices. Leave unset
# when the container sees every GPU at its host index. G-14: docker-compose.yml
# interpolates BOTH this var and curation-trainer's device_ids from it, so
# setting it here moves both together for the single-GPU default. A
# multi-GPU OP_TRAIN_GPU_ORDER (e.g. "0,2") needs a compose override file
# for device_ids too -- see the comment beside curation-trainer's
# device_ids in docker-compose.yml.
# OP_TRAIN_GPU_ORDER=0
# Class names whose content is orientation-sensitive (text, digits, signage).
# Horizontal flip is disabled for any run that trains one of them. Matched
# case-insensitively against the training data.yaml's `names`. Per-job
# override: job.json's `augmentation.text_class_names`.
# OP_TRAIN_TEXT_CLASS_NAMES=
# Triton models to compare a finished run against, in preference order; the
# first one Triton reports READY wins. Unset (default) skips the comparison
# and leaves status.compare null.
# OP_TRAIN_INCUMBENT_MODELS=
# OP_TRAIN_COMPARE_MAX_IMAGES=200
# OP_TRAIN_COMPARE_INPUT_SIZE=640
# Triton model repository. Read by the trainer (to read an incumbent's
# labels.txt so comparison rows carry names, not bare ids) AND by yolo-api's
# promote path (src/services/training/triton_promote.py) and model discovery
# (src/routers/curation/models.py) -- the promote writer and the running
# Triton server must agree on this path or a promoted model silently lands
# somewhere Triton never sees. Must match whatever host directory is
# bind-mounted into BOTH yolo-api and triton-server; main's own
# docker-compose.yml mounts it at /app/models for yolo-api, so this normally
# doesn't need to be set there -- set it explicitly in any deployment overlay
# that mounts the repo somewhere else (e.g. /models).
# OP_TRITON_MODEL_REPO=/models
# OP_TRITON_HTTP_URL=http://triton-server:8000
# API base the trainer POSTs a campaign's auto-promote to (joined with
# OP_API_PREFIX).
# OP_API_BASE_URL=http://yolo-api:8000
# OP_TRAIN_LOG_LEVEL=INFO
# MLflow (optional; every hook degrades to a warning when unreachable).
# MLFLOW_TRACKING_URI=http://curation-mlflow:5000
# MLFLOW_EXPERIMENT_NAME=openprocessor
# OP_MLFLOW_MODEL_NAME=openprocessor_detector
# OP_MLFLOW_CONFUSION_MATRIX_EVERY=25
# Browser-reachable base URL for the MLflow UI (e.g. a reverse-proxied
# https://mlflow.example.com). MLFLOW_TRACKING_URI above is a container
# hostname the trainer uses internally and a browser can never resolve --
# the API rewrites the served train/status + train/manifest
# ``mlflow_run_url`` to use this base instead, and GET /curation/health
# serves it directly as mlflow_public_url. Unset = served as null
# (mlflow_run_id is still served either way).
# OP_MLFLOW_PUBLIC_URL=https://mlflow.example.com

# GPU arbiter (src/config/gpu_arbiter.py — GpuArbiterConfig.from_env).
# Comma-separated GPU ids a training / bake-off job may target; any other id
# is rejected at job submission. Unset/empty = unrestricted (any id).
# OP_GPU_ALLOWED_IDS=0,2
# Containers stopped (in order) while a run holds the GPUs and restarted
# when it releases them. Unset/empty = no container coordination. Each
# entry is a bare name (stopped only when a claim spans >1 GPU) or
# name@ids, where ids is /-separated (name@2, name@0/2) -- a scoped
# container is stopped whenever a claim intersects its GPU set, even a
# single-GPU claim.
# OP_GPU_ARBITER_CONTAINERS=
# Trainer container probed for reachability before a run starts.
# F-72: docker-compose.yml now wires this by default to
# ${COMPOSE_PROJECT_NAME:-openprocessor}-trainer (the trainer service's
# own container_name) whenever it's unset here, so a deployment running
# the `training` profile gets a working probe with no extra config.
# Set this only to override that default (e.g. a renamed/external
# trainer container). Empty string still means "skip the probe".
# OP_GPU_ARBITER_TRAINER_CONTAINER=
# Human-readable GPU card names for GET /curation/train/gpus option labels.
# Comma-separated id=label pairs. Unset ids just render as "GPU {id}".
# OP_GPU_LABELS=0=RTX A6000,1=RTX 3080 Ti,2=RTX A6000
# Default cuda_visible_devices for a new training spec. Unset = the
# smallest OP_GPU_ALLOWED_IDS entry, else '0' (unrestricted install).
# OP_TRAIN_DEFAULT_GPUS=
# Host GPU ids the bake-off evaluator container is attached to (e.g. '0';
# distinct from OP_BAKEOFF_GPUS below, which is the evaluator's
# container-local id). When set, enqueueing a bake-off -- and the reconcile
# loop while one is queued -- only stops configured containers whose GPU
# scope intersects these ids, instead of stopping everything configured.
# Unset = old behavior (stop every configured container on any bake-off).
# OP_BAKEOFF_HOST_GPUS=
# (The arbiter's bake-off queue dir is OP_BAKEOFF_JOBS_DIR, below.)

# =============================================================================
# Curation export (src/services/curation/export.py)
# =============================================================================
# Baked into yolo-api / curation-trainer / curation-evaluator at BUILD time
# (docker-compose.yml build.args) so every manifest's code_versions.api_sha
# and code_versions.trainer_sha reflect the actual built commit, not a dev
# checkout's live `git rev-parse HEAD` fallback (`make build`/`make rebuild`
# already pass this). Setting it here overrides the baked value at
# *runtime* instead — useful for a dev stack that bind-mounts src/ over a
# stale image.
# OP_BUILD_SHA=

# =============================================================================
# Curation model comparison / bake-off (src/routers/curation/bakeoff.py,
# scripts/curation/bakeoff/, curation-evaluator service)
# =============================================================================
# Eval datasets are every export under OP_EXPORT_ROOT with a labelled test
# split, plus frozen external sets (TEST_FROZEN.json) under
# OP_BAKEOFF_EVAL_ROOT/{curated,public,sample}. The evaluator must see both
# at the same paths as the API (compose mounts ./data read-only on it).
#
# Job queue the API writes and the evaluator watches. Unset = the same
# $OP_STATE_DIR/bakeoff_jobs for the router and the GPU arbiter (which keeps
# GPU-resident containers stopped while a job file is queued), matching the
# evaluator image's default watch dir. Set it only to move all three.
# OP_BAKEOFF_JOBS_DIR=/var/lib/openprocessor/bakeoff_jobs
# OP_BAKEOFF_OUT_DIR=/var/lib/openprocessor/bakeoff_out
# OP_BAKEOFF_EVAL_ROOT=./data/bakeoff_eval
# Evaluator parallelism and its container-local GPU ids.
# OP_BAKEOFF_CONCURRENCY=4
# OP_BAKEOFF_GPUS=0
# Registry of external baseline models served by
# GET /curation/bakeoff/baseline_models (default: the empty
# scripts/curation/bakeoff/baselines.json; previous training runs are the
# usual baselines).
# OP_BAKEOFF_BASELINES_PATH=
# Default BakeoffProfile when a job names none: a registered name (generic)
# or a path to a profile .json file. Unset = generic (scores every class in
# the test split). Example profiles are opt-in by path and need examples/
# mounted into both yolo-api and the evaluator, e.g. with ./examples mounted
# at /app/examples:
#   OP_BAKEOFF_PROFILE=/app/examples/bakeoff/license_plate/profile.json
# OP_BAKEOFF_PROFILE=
# Per-field overrides of the generic profile (scripts/curation/bakeoff/profile.py).
# Pattern: OP_BAKEOFF_PROFILE_<FIELD>, e.g. (comma lists; class names to score):
# OP_BAKEOFF_PROFILE_CLASS_FILTER=
# OP_BAKEOFF_PROFILE_CONTEXT_CLASS_IDS=

# =============================================================================
# Curation worker / pipeline flags (scripts/curation/, src/services/curation/autolabel/)
# =============================================================================
# OP_API=http://localhost:4603
# OP_AUTO_LABEL_STATE_DIR=/jobs/auto_label
# S-3: explicit override for where the detection worker POSTs
# crop.region_verified events (src/services/curation/event_hub.py). If
# unset, scripts/curation/worker/bulk_writer.py falls back to
# OP_API_BASE_URL, then OP_API — usually already set to the same host,
# so most deployments never need this var at all.
# OP_EVENT_API_URL=
# S-3: cross-process event bus backend. `file` (default) makes every
# uvicorn worker (and any process posting to /events/publish) see every
# published event via a shared JSONL log under
# {OP_STATE_DIR}/events/events.jsonl. `process` restores the pre-S-3
# in-process-only behavior (fine for a single-worker deployment or
# tests).
# OP_EVENT_BUS=file
# S-3: size (bytes) at which the shared event log rotates to a single
# `.1` backup — the log never exceeds roughly 2x this on disk.
# OP_EVENT_LOG_MAX_BYTES=8388608
# S-2: container-local dir the curation worker healthchecks read/write
# heartbeat files in (src/services/curation/worker_liveness.py). No
# mount needed — the healthcheck always runs inside the same container
# as the worker it's checking.
# OP_HEARTBEAT_DIR=/tmp/openprocessor_heartbeat
# OP_ITEMS_INDEX_OVERRIDE=op_items
# OP_PAUSE_SENTINEL=/var/lib/openprocessor/vlm_worker/pause.sentinel
# OP_WORKER_PAUSE_SENTINEL=/var/lib/openprocessor/vlm_worker/pause.sentinel
# OP_VIZ_JOBS_DIR=/jobs/viz
# OP_VIZ_MAX_N=20000
# BLAS thread caps for curation-auto-label-worker (AHC/UMAP on the residual
# pool otherwise spawns one thread per host core -- 48 on the reference
# host -- and starves everything else on a shared machine). Lower = slower
# clustering, less CPU contention; unset one and it inherits the library
# default (all cores).
# OMP_NUM_THREADS=4
# OPENBLAS_NUM_THREADS=4
# MKL_NUM_THREADS=4

# =============================================================================
# VLM (OpenAI-compatible /v1/chat/completions endpoint) — labeling +
# region-verification (src/services/labeling/vlm_client.py,
# scripts/curation/worker/state.py)
# =============================================================================
# G-10: three ways to get a VLM behind OP_VLM_URL:
#   1. Run the shipped `vlm` service: `docker compose --profile vlm up -d`,
#      then OP_VLM_URL=http://vlm:8000/v1 (below). See "In-compose VLM
#      (--profile vlm)" further down for its own knobs.
#   2. Point at one already running on THIS host (outside compose):
#      OP_VLM_URL=http://host.docker.internal:<port>/v1 -- yolo-api and
#      curation-vlm-worker both carry the `host.docker.internal:host-gateway`
#      extra_hosts entry needed for this to resolve on Linux (Docker
#      Desktop adds it for you; the Linux engine does not by default).
#   3. Point at a VLM on the network somewhere else:
#      OP_VLM_URL=http://<host>:<port>/v1.
# OP_VLM_URL=http://host.docker.internal:8012/v1
# OP_VLM_MODEL is REQUIRED whenever OP_VLM_URL is set -- there is no
# default model id; construction fails loudly without one.
# OP_VLM_MODEL=
# OP_VLM_API_KEY=EMPTY
# Open-vocab labeling chunk size only (default 3; clamped to the cap below).
# OP_VLM_OPEN_IMAGES_PER_CALL=3
# Per-request image cap for EVERY VLM call (labeling, verify, visibility,
# combined). Must be <= your serving engine's per-prompt image limit (vLLM:
# --limit-mm-per-prompt '{"image": N}') or requests 400. Default 8.
# OP_VLM_MAX_IMAGES_PER_CALL=8
# OP_VLM_HTTPX_MAX_CONNECTIONS=512
# OP_VLM_HTTPX_KEEPALIVE=128
# Detection worker (scripts/curation/worker): VLM endpoint override and
# stage concurrency.
# OP_VLM_URL=
# OP_REGION_WORKER_VLM_CONCURRENCY=16
# OP_REGION_WORKER_VLM_VISIBLE_CONCURRENCY=8
# Prometheus metrics port for the region worker's own /metrics server.
# OP_REGION_WORKER_METRICS_PORT=4609
# OP_SEGMENTER_SKIP_VERIFY_SCORE=0.95
# How many VLM replies with no verdict (null box verdict, unparseable entry,
# empty visibility reply) an item gets per stage before the worker stops
# retrying it: the combined stage then writes verify_rejected with reason
# verifier_no_verdict (candidate kept for human review; requeue with
# --reason verifier_no_verdict), the visibility stage sends it on to
# detection. Counted in-process (a restart resets it); VLM transport
# failures never count. Default 3, minimum 1.
# OP_REGION_WORKER_MAX_NO_VERDICT_ATTEMPTS=3

# =============================================================================
# In-compose VLM (--profile vlm) — the `vlm` service in docker-compose.yml.
# Read by compose only (not the Python app); irrelevant if you point
# OP_VLM_URL at a VLM you already run elsewhere.
# =============================================================================
# Pin a real vLLM release tag; confirm it supports your model's multimodal
# (image) input before relying on it.
# VLM_IMAGE=vllm/vllm-openai:gemma4-cu130@sha256:0d152595cd940ea1e0890fa190a37b7a86e3f7f0f5048ac3e2e4c14529fea833
# VLM_MODEL=google/gemma-4-E4B-it
# VLM_SERVED_MODEL_NAME=gemma-4-e4b
# VLM_DTYPE=bfloat16
# VLM_MAX_MODEL_LEN=8192
# Fraction of the GPU's VRAM this service may claim. Share the GPU with
# Triton/the segmenter/training by lowering this -- e.g. an A6000 (48GB)
# running Triton (~10GB) + segmenter (~4GB) + this VLM at 0.30 (~14GB)
# leaves headroom; a 12-24GB card fits a smaller/quantized model instead.
# VLM_GPU_MEMORY_UTILIZATION=0.4
# COUPLING (G-10): this is vLLM's `--limit-mm-per-prompt` image cap -- the
# SERVER side of the same contract as OP_VLM_MAX_IMAGES_PER_CALL (the
# CLIENT side, above). They must be equal, or requests above the smaller
# one 400. Changing one without the other is the most common
# "VLM labeling returns 400s" misconfiguration.
# VLM_LIMIT_MM_IMAGES=8
# VLM_GPU_ID=0
# VLM_PORT is set (active, not commented) in the Port Configuration
# section above.

# =============================================================================
# Segmenter (SAM3-style) service — detection cascade's segmenter leg
# (scripts/curation/worker/client.py, src/services/detection/cascade_detect.py)
# =============================================================================
# Client side: where the detection worker looks for a segmenter. Empty
# (the default) makes the segmenter leg a no-op. Point it at the shipped
# `segmenter` service (`docker compose --profile segmenter up -d`) or at
# your own; OP_SEGMENTER_URLS takes a comma-separated list to load-balance.
# OP_SEGMENTER_URL=http://segmenter:8000
# OP_SEGMENTER_URLS=
# OP_SEGMENTER_HTTPX_MAX_CONNECTIONS=512
# OP_SEGMENTER_HTTPX_KEEPALIVE=128

# Server side: the shipped segmenter container (docker/segmenter/).
# HF_TOKEN is required — the SAM 3 weights are gated on HuggingFace.
# HF_TOKEN=
# SEGMENTER_DEVICE=cuda:0
# G-12: SEGMENTER_INSTANCES x model VRAM is the dominant cost unless
# SEGMENTER_SHARED_WEIGHTS=1 (all instances share one copy of the weights
# and only pay per-instance activation memory -- the recommended setting
# whenever VRAM is tight). See README "GPU sizing" for measured numbers
# per instance count; as a rule of thumb, start at 1-2 instances on a
# 12-24GB card and 2-4 on a 48GB card, shared weights on either way.
# SEGMENTER_INSTANCES=2
# SEGMENTER_SHARED_WEIGHTS=1
# SEGMENTER_COMPILE=0
# SEGMENTER_ENABLE_MASKS=1
