      "device": "cuda",
      "coords_normalized": false,
      "ort_providers": "CUDAExecutionProvider,CPUExecutionProvider",
      "training_data": "curated YOLO26 (FP16 ONNX — primary NVIDIA deliverable)"
    },
    {
      "name": "ours_int8_onnx",
      "backend": "onnxruntime",
      "weights": "/data/curation_train_data/quant/ours_yolo26n/int8_qdq.onnx",
      "imgsz": 640,
      "device": "cuda",
      "coords_normalized": false,
      "ort_providers": "TensorrtExecutionProvider,CUDAExecutionProvider,CPUExecutionProvider",
      "training_data": "curated YOLO26 (INT8 QDQ ONNX — lighter/faster)"
    }
  ]
