      "device": "cuda",
      "training_data": "NVIDIA TAO (US)"
    },
    {
      "name": "ours_fp32_onnx",
      "backend": "onnxruntime",
      "weights": "/data/curation_train_data/quant/ours_yolo26n/fp32.onnx",
      "imgsz": 640,
      "device": "cuda",
