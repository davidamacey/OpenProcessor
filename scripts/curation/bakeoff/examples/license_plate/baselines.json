{
  "_comment": "Example baseline registry for the license_plate example profile: public license-plate detectors. 'weights' paths are placeholders relative to the evaluator container's working directory; download the checkpoints yourself and point these at them.",
  "baselines": [
    {
      "name": "open-image-models-yolov9t",
      "backend": "open-image-models",
      "imgsz": 1280,
      "device": "cuda",
      "training_data": "open plate datasets"
    },
    {
      "name": "ml-debi-yolov8",
      "backend": "ultralytics",
      "weights": "./weights/ml-debi_yolov8_lpd/best.onnx",
      "imgsz": 640,
      "device": "cuda",
      "training_data": "undocumented"
    },
    {
      "name": "morsetechlab-yolo11s",
      "backend": "ultralytics",
      "weights": "./weights/morsetechlab_yolov11_lpd/license-plate-finetune-v1s.pt",
      "imgsz": 640,
      "device": "cuda",
      "training_data": "Roboflow ALPR"
    },
    {
      "name": "lpdnet-usa",
      "backend": "lpdnet",
      "weights": "./weights/lpdnet_pruned_v2.2.1/LPDNet_usa_pruned_tao5.onnx",
      "lpdnet_variant": "usa",
      "device": "cuda",
      "training_data": "NVIDIA TAO (US)"
    }
  ]
}
