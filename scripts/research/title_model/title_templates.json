    "beach day": {"family": "beach", "word": "beach"}, "birthday": {"family": "birthday"},
    "camping trip": {"family": "hiking", "word": "camping"}, "ski trip": {"family": "snow", "word": "skiing"},
    "road trip": {"family": "transport"}, "graduation": {"family": "party"},
    "anniversary": {"family": "party"}, "family reunion": {"family": "party"},
    "picnic": {"family": "party"}, "barbecue": {"family": "party"}
