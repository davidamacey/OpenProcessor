{
  "version": 1,
  "note": "Template table of run R8, our own wording. Placeholders: {place} {person} {people} {month} {year} {event}. Row picked by the sheet's event, else its first kept scene word; variant by the sheet: group (2 or 3 named people), person (1), place, plain. A sheet with no event and no scene word gets the plain template '<place>, <month year>' (the family 'none'). word_rows override a family's rows for one member word.",
  "variant_fallback": {"group": ["person", "place", "plain"], "person": ["place", "plain"], "place": ["plain"], "plain": []},
  "none": {"use": "plain_template"},
  "events": {
    "wedding": {"family": "wedding"}, "concert": {"family": "concert", "word": "concert"},
