#!/bin/bash
# Test double for df: ~2 TB free, or 4 GB when $SHIM_STATE/low_disk exists, or
# when the path asked about is under the prefix in $SHIM_STATE/low_disk_path.
low=0
[[ -e "${SHIM_STATE:-/nonexistent}/low_disk" ]] && low=1
if [[ -f "${SHIM_STATE:-/nonexistent}/low_disk_path" ]]; then
    prefix="$(cat "${SHIM_STATE}/low_disk_path")"
    [[ "${*: -1}" == "${prefix}"* ]] && low=1
fi
if (( low )); then
    printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\nshimfs 100000000 96000000 4194304 96%% /\n'
    exit 0
fi
printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\n'
printf 'shimfs 4000000000 1000000000 2000000000 33%% /\n'
