#!/bin/bash
# Test double for nvidia-smi: GPU rows come from $SHIM_STATE/gpus.csv.
printf 'nvidia-smi %s\n' "$*" >> "${SHIM_LOG:?}"
case "$*" in
    *--query-gpu=memory.total,memory.free*)
        # `-i N`: this card's "total, free" in MiB, from the gpus.csv row
        # (index, name, memory.total, memory.used, compute_cap).
        [[ -f "${SHIM_STATE:?}/gpus.csv" ]] || { echo "NVIDIA-SMI has failed" >&2; exit 9; }
        idx=0
        args=("$@")
        for ((i = 0; i < ${#args[@]}; i++)); do
            [[ "${args[i]}" == "-i" ]] && idx="${args[i + 1]}"
        done
        awk -F', *' -v n="$idx" '$1 == n { printf "%d, %d\n", $3, $3 - $4 }' "${SHIM_STATE}/gpus.csv"
        ;;
    *--query-compute-apps*)
        # rows "pid, gpu_uuid, used_mib" from $SHIM_STATE/compute_apps.csv
        cat "${SHIM_STATE:?}/compute_apps.csv" 2>/dev/null || true
        ;;
    *--query-gpu=index,uuid*)
        cat "${SHIM_STATE:?}/gpu_uuids.csv" 2>/dev/null || true
        ;;
    *--query-gpu*)
        [[ -f "${SHIM_STATE:?}/gpus.csv" ]] || { echo "NVIDIA-SMI has failed" >&2; exit 9; }
        cat "${SHIM_STATE}/gpus.csv"
        ;;
    *) ;;
esac
