  {
   "id": "yield_requeues_behind_other_work_without_a_retry",
   "description": "A sliced job that yields goes back to queued behind work that arrived meanwhile, keeps its retry budget, and its attempt ends yielded.",
   "steps": [
    {
     "op": "insert",
     "job": "a",
     "kind": "assist_loop",
     "project": "p1",
     "expect": "created"
    },
    {
     "op": "claim",
     "runner": "r1",
     "kinds": [
      "assist_loop"
     ],
     "limit": 1,
     "expect": [
      "a"
     ]
    },
    {
     "op": "insert",
     "job": "b",
     "kind": "assist_loop",
     "project": "p2",
     "expect": "created"
    },
    {
     "op": "conclude",
     "job": "a",
     "token": "current",
     "how": "yield",
     "expect": "ok",
     "status_after": "queued"
    },
    {
     "op": "expect",
     "job": "a",
     "status": "queued",
     "retry_count": 0,
     "owner": null,
     "attempts": [
      "yielded"
     ]
    },
    {
     "op": "claim",
     "runner": "r1",
     "kinds": [
      "assist_loop"
     ],
     "limit": 1,
     "expect": [
