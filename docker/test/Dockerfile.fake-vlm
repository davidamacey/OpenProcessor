# =============================================================================
# Fake OpenAI-compatible vision chat endpoint for the live verification
# harness. Standard library only — no pip install, no network at build
# time beyond the base image.
# =============================================================================
FROM python:3.14-slim@sha256:cd89c30eda26ee911a4611b18680086e0ea42e6f5f8cbe653d07fa7958c9cec8

WORKDIR /app

COPY fake_vlm.py /app/fake_vlm.py

USER nobody

EXPOSE 8000

HEALTHCHECK --interval=5s --timeout=5s --start-period=5s --retries=10 \
    CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"]

CMD ["python3", "-u", "/app/fake_vlm.py"]
