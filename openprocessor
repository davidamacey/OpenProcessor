# New in the deploy-mode CLI (installer plan section 5.5)
# =============================================================================

cmd_sample() {
    local sub="${1:-coco}"
    shift 2>/dev/null || true
    case "$sub" in
        coco)
            # shellcheck source=scripts/lib/model_setup.sh
            source "${SCRIPT_DIR}/lib/model_setup.sh"
            log_step "Fetching the public COCO sample (writes to /app/data/samples, no host Python)..."
            model_setup_sample_coco "${1:-}"
            ;;
        *)
            log_error "unknown sample: $sub (only 'coco' is supported)"
            return 1
            ;;
    esac
}

cmd_config() {
    local sub="${1:-show}"
    case "$sub" in
        show)
            local env_file="${PROJECT_DIR}/.env"
            [[ -f "$env_file" ]] || { log_error "no .env at ${env_file}"; return 1; }
            # Redact every token/key/secret/password value, with or
            # without a leading `export`.
            sed -E 's/^([[:space:]]*(export[[:space:]]+)?[A-Z0-9_]*(TOKEN|KEY|SECRET|PASSWORD)[A-Z0-9_]*)=.*/\1=***/' "$env_file"
            ;;
        *)
            log_error "unknown config subcommand: $sub"
            return 1
            ;;
    esac
}

cmd_gpu() {
    local sub="${1:-plan}"
    case "$sub" in
        plan)
            log_step "GPU plan (from .env)"
            for key in TRITON_GPU_ID API_GPU_ID SEGMENTER_GPU_ID VLM_GPU_ID EVALUATOR_GPU_ID GPU_PROFILE; do
                local value
                value="$(_env_value "$key")"
                echo "  ${key}=${value:-<unset>}"
            done
            ;;
        *)
            log_error "unknown gpu subcommand: $sub"
            return 1
            ;;
    esac
}

cmd_vlm() {
    local sub="${1:-list}"
    shift 2>/dev/null || true
    case "$sub" in
        list)
            log_step "VLM catalog"
            printf '%-20s %-10s %-8s %-10s\n' "id" "licence" "vram_gb" "status"
            while IFS=$'\t' read -r id _repo licence vram _sctx _mctx _maximg status _rank _gated _key; do
                printf '%-20s %-10s %-8s %-10s\n' "$id" "$licence" "$vram" "$status"
            done < <(vlm_catalog_rows)
            ;;
        status) _vlm_status ;;
        use) _vlm_use "$@" ;;
        apply) _vlm_apply "$@" ;;
        probe) _vlm_probe ;;
        key)
            local action="${1:-}" slug="${2:-}"
            if [[ "$action" != "set" || -z "$slug" ]]; then
                log_error "usage: openprocessor vlm key set <slug>"
                return 2
            fi
            if [[ ! "$slug" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]]; then
                log_error "slug must match [a-z0-9][a-z0-9_-]{0,63}"
                return 2
            fi
            if ! { : </dev/tty; } 2>/dev/null; then
                log_error "no terminal to read the key from"
                return 2
            fi
            ( umask 077; mkdir -p "${PROJECT_DIR}/secrets/vlm" )
            chmod 700 "${PROJECT_DIR}/secrets" "${PROJECT_DIR}/secrets/vlm"
            local key_value=""
            printf "VLM API key for '%s' (input hidden): " "$slug" >/dev/tty
            IFS= read -rs key_value </dev/tty || true
            printf '\n' >/dev/tty
            [[ -n "$key_value" ]] || { log_error "empty key"; return 2; }
            ( umask 077; printf '%s' "$key_value" > "${PROJECT_DIR}/secrets/vlm/${slug}" )
            key_value=""
            chmod 600 "${PROJECT_DIR}/secrets/vlm/${slug}"
            log_success "stored secrets/vlm/${slug} (mode 600); reference it as secret:${slug}"
            ;;
        *)
            log_error "unknown vlm subcommand: $sub"
            return 1
            ;;
    esac
}

cmd_train_mode() {
    local mode="${1:-}" state="${PROJECT_DIR}/.install/train_mode" trn seg services=(vlm)
    trn="$(_env_value OP_TRAIN_GPU_ORDER)"
    seg="$(_env_value SEGMENTER_GPU_ID)"
    if [[ -n "$trn" && "$trn" == "$seg" ]]; then
        services+=(segmenter)
    fi
    case "$mode" in
        on)
            log_step "train-mode on: stopping ${services[*]} for the training run"
            dc stop "${services[@]}"
            ( umask 077; mkdir -p "${PROJECT_DIR}/.install"; printf 'on %s\n' "${services[*]}" > "$state" )
            log_success "train-mode on (stopped: ${services[*]})"
            ;;
        off)
            if [[ -f "$state" ]]; then
                read -r _ services_line < "$state" || true
                read -ra services <<< "${services_line:-vlm}"
            fi
            log_step "train-mode off: starting ${services[*]}"
            dc up -d "${services[@]}"
            ( umask 077; printf 'off\n' > "$state" )
            log_success "train-mode off (started: ${services[*]})"
            ;;
        *)
            log_error "usage: openprocessor train-mode on|off"
            return 2
            ;;
    esac
}

# One code path: lifecycle commands run this install's own verified
# setup-openprocessor.sh against this directory.
_run_setup() {
    if [[ "$IS_CHECKOUT" == 1 || ! -x "$PROJECT_DIR/setup-openprocessor.sh" ]]; then
        log_error "this is not an installer-managed directory (use git + make in a checkout)"
        return 1
    fi
    resolve_project
    exec "$PROJECT_DIR/setup-openprocessor.sh" --dir "$PROJECT_DIR" "$@"
}

cmd_upgrade() { _run_setup "$@"; }
cmd_repair() { _run_setup --repair "$@"; }
cmd_uninstall() { _run_setup --uninstall "$@"; }

# =============================================================================
# Main
# =============================================================================

main() {
    local command="${1:-help}"
    shift 2>/dev/null || true

    case "$command" in
        start)
            cmd_start "$@"
            ;;
        stop)
            cmd_stop "$@"
            ;;
        restart)
            cmd_restart "$@"
            ;;
        logs)
            cmd_logs "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        health)
            cmd_health "$@"
            ;;
        models)
            cmd_models "$@"
            ;;
        export)
            cmd_export "$@"
            ;;
        download)
            cmd_download "$@"
            ;;
        profile)
            require_checkout "profile" && cmd_profile "$@"
            ;;
        test)
            require_checkout "test" && cmd_test "$@"
            ;;
        curation)
            cmd_curation "$@"
            ;;
        bench)
            require_checkout "bench" && cmd_bench "$@"
            ;;
        clean)
            cmd_clean "$@"
            ;;
        update)
            cmd_update "$@"
            ;;
        setup)
            require_checkout "setup" && exec "${SCRIPT_DIR}/setup.sh" "$@"
            ;;
        sample)
            cmd_sample "$@"
            ;;
        config)
            cmd_config "$@"
            ;;
        gpu)
            cmd_gpu "$@"
            ;;
        vlm)
            cmd_vlm "$@"
            ;;
        train-mode)
            cmd_train_mode "$@"
            ;;
        upgrade)
            cmd_upgrade "$@"
            ;;
        repair)
            cmd_repair "$@"
            ;;
        uninstall)
            cmd_uninstall "$@"
            ;;
        version)
            echo "openprocessor CLI ${OP_CLI_VERSION:-0.4.1}"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            log_error "Unknown command: $command"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
