# ============================================================================
# Triton YOLO Inference Server - .gitignore
# ============================================================================

# ============================================================================
# Project-Specific (Triton + YOLO)
# ============================================================================

# TensorRT engines and caches
*.engine
*.plan
*.profile
*.backup
trt_cache/
models/*/1/*.plan
models/*/1/*.engine

# Model weights (large files - download locally)
*.pt
*.onnx
*.safetensors
*.weights
*.pth

# DALI pipeline files (generated, can be recreated via scripts)
models/*/1/*.dali

# Triton model repository dynamic files
models/*/1/warmup/

# PyTorch models (download via scripts)
pytorch_models/*.pt
pytorch_models/*.onnx

# Ultralytics cache and runs
.ultralytics/
runs/
yolov*[0-9]/  # Matches yolov8/, yolov11/ etc. but not yolov11_small_trt/

# ============================================================================
# Benchmark and Test Results
# ============================================================================

# Go compiled binary (rebuilt via build.sh)
benchmarks/triton_bench

# Benchmark results (auto-generated)
results/
benchmarks/results/

# Load test results
load_test_results/
locust_*.html
locust_*.csv

# Clustering test output (mosaics, visualizations)
cluster_test_output/

# Test results (generated during testing)
test_results/

# Security scan reports (generated by security-scan.sh)
security-reports/

# Pipeline output (mosaics, clusters, visualizations)
outputs/

# Triton Python backends (created by Docker at runtime, repo root only --
# an unanchored `backends/` also hid source packages named backends/)
/backends/
# ...except the bake-off harness's `backends/` subpackage (source code,
# not a runtime-generated dir) -- see docs/design/oss_genericization_
# phase2_plan.md Chunk 6.
!scripts/curation/bakeoff/backends/

# FAISS index files (generated during training)
faiss_indexes/

# ============================================================================
# Test Data and Samples
# ============================================================================

# Test images and videos (use external paths or download separately).
#
# F-29/F-71 (fresh-start E2E findings 2026-09-25): yolo-api bind-mounts
# ./test_images. On a fresh clone that host dir doesn't exist, so Docker
# auto-creates it root-owned on the first `up`, and `make
# download-test-images` (running as the host user) can't write into it.
# F-29's first fix shipped a tracked `test_images/.gitkeep` placeholder so
# `git clone` itself created the dir, host-user-owned, before compose
# ever ran -- but that broke `git pull` on any EXISTING install whose
# `test_images/` was already root-owned from before this fix (git needs
# write access to materialize the new tracked file there; the pull
# aborted half-applied, HEAD unmoved). Fixed properly instead: `make up`
# / `make up-monitoring` now depend on `ensure-host-bind-mount-dirs`,
# which `mkdir -p`s this (and the other bind-mount source dirs) as the
# invoking host user before compose ever runs -- no tracked file needed.
# Recovery for an install already stuck with a root-owned test_images/:
#   sudo chown -R $(id -u):$(id -g) test_images
test_images/
test_videos/
sample_data/
IMGS_TEST/
/SAMPLE_PICTURES/

# Fetched public sample datasets (scripts/datasets/, G-05) -- pinned
# manifests under scripts/datasets/manifests/ ARE committed; only the
# downloaded imagery/CSVs under data/samples/ are ignored here.
/data/samples/
# F-15: export_models.py's --generate-config / --save-labels run writes
# this every invocation, reflecting whichever models/formats *that* run
# exported (host paths, per-model results) -- a run artifact, not source,
# and it was previously tracked, so every export run dirtied the tree
# even when nothing about the repo's own config changed.
/scripts/export_results.json
# Class registry generated at runtime (default OP_REGISTRY_PATH); the
# warehouse example data/class_registry.example.json IS committed.
/data/class_registry.json
# F-45: every class-registry write leaves a timestamped backup snapshot
# (data/class_registry.<ISO8601Z-with-micros>.json) that isn't tracked.
# The one prior attempt at this (a2abeb9) added only a test and never
# added a pattern -- `git check-ignore` on a real backup file returned
# nothing. Match the writer's actual timestamp format (see
# src/services/curation/registry_backup.py or equivalent): digits, T,
# more digits, optional micros, Z, .json.
/data/class_registry.[0-9]*Z.json
/data/exports/*
# Anchored at repo root -- an earlier unanchored `backends/` pattern
# accidentally hid the bake-off harness's source subpackage (see the
# `/backends/` note above). Anchor `cache/` the same way. `!` re-includes
# must walk down directory-by-directory or git never looks inside an
# excluded dir to find the negated file.
/cache/**
!/cache/huggingface/
!/cache/huggingface/.gitkeep

# ============================================================================
# Reference Repositories (External Code for Research)
# ============================================================================

# External repos cloned for reference (36MB - not needed in version control)
reference_repos/

# HuggingFace cache (tokenizers, models - downloaded at runtime):
# superseded by the anchored /cache/** rule above (G-17).

