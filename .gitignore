# docs/CURATION.md "GPU arbiter container coordination".
!docker-compose.gpu-arbiter.yml
# docker-compose.override.yml is generated by setup.sh - do not commit

# Environment template output (auto-generated by setup)
# Note: env.template is committed, .env is generated

