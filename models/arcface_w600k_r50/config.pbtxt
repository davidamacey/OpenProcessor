name: "arcface_w600k_r50"
platform: "tensorrt_plan"
max_batch_size: 128

input {
    name: "input"
    data_type: TYPE_FP32
    dims: [3, 112, 112]
}

output {
    name: "output"
    data_type: TYPE_FP32
    dims: [512]
}

dynamic_batching {
    preferred_batch_size: [8, 16, 32, 64]
    max_queue_delay_microseconds: 15000
}

instance_group [{
    # F-19 (fresh-start E2E findings 2026-09-25): count 4 measured at
    # ~2.75 GB; the default core loadout has to share a 48 GB card with
    # the VLM + segmenter + trainer. count: 1 is ~0.7 GB -- raise this
    # on a card with headroom to spare (see README "GPU sizing").
    count: 1
    kind: KIND_GPU
    gpus: [0]
}]

version_policy {
    latest {
        num_versions: 1
    }
}
