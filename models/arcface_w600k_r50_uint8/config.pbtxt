name: "arcface_w600k_r50_uint8"
platform: "tensorrt_plan"
max_batch_size: 128

input {
    name: "images"
    data_type: TYPE_UINT8
    dims: [3, 112, 112]
}

output {
    name: "output"
    data_type: TYPE_FP32
    dims: [512]
}

dynamic_batching {
    preferred_batch_size: [8, 16, 32, 64]
    max_queue_delay_microseconds: 15000
}

instance_group [{
    # Count 1 is the default core loadout's baseline (~0.7 GB);
    # raise on a card with headroom to spare (see README "GPU sizing").
    count: 1
    kind: KIND_GPU
    gpus: [0]
}]

version_policy {
    latest {
        num_versions: 1
    }
}
