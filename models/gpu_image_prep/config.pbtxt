# gpu_image_prep: decode a photo once on the GPU and derive every ingest input from that frame
# (Python backend, decoupled: requests from all API workers run concurrently on worker threads
# inside one process, one CUDA context). See 1/model.py. Loaded only when photo ingest uses the GPU decode
# (OP_INGEST_GPU_DECODE, on by default); the API decodes on the CPU otherwise.
#
# Inputs:
#   - jpeg:          [-1] UINT8, the encoded image as uploaded
#   - embed_crops:   [1] BOOL (optional, default true), also embed every detection's square
#   - boxes:         [-1, 4] FP64 (optional), stored bbox_norm rows (x1, y1, x2, y2 in [0, 1] of
#                    the oriented frame). Stored-box mode, the reprocess embed pass (#259): no
#                    detector, blur sums or JPEGs; the answer is status, size, whole_embedding and
#                    crop_embeddings with one row per box, in order
# Outputs (status "ok"; any other status is the reason the API decodes this image on the CPU, among
# them gpu_memory and over_budget, see DEVICE_BUDGET_MIB below):
#   - status:          [1] STRING
#   - size:            [2] INT32, width and height after EXIF orientation
#   - letterbox:       [3] FP64, scale, pad_w, pad_h of the detector letterbox
#   - det_boxes:       [-1, 4] FP32, det_scores [-1] FP32, det_classes [-1] INT32 (end2end rows)
#   - whole_embedding: [-1] FP32, PE embedding of the whole-frame square (not normalized)
#   - crop_embeddings: [-1, -1] FP32, one per detection when embed_crops, or one per stored box
#                      (not normalized)
#   - blur_sums:       [-1, 3] INT64, (pixels, Laplacian sum, sum of squares): the frame, then
#                      each detection's clamped rectangle (pixels 0: empty)
#   - crop_jpegs:      [-1] STRING, each detection's crop, JPEG quality 90

name: "gpu_image_prep"
backend: "python"
max_batch_size: 0
model_transaction_policy { decoupled: true }

input [
  { name: "jpeg", data_type: TYPE_UINT8, dims: [ -1 ] },
  { name: "embed_crops", data_type: TYPE_BOOL, dims: [ 1 ], optional: true },
  { name: "boxes", data_type: TYPE_FP64, dims: [ -1, 4 ], optional: true }
]
output [
  { name: "status", data_type: TYPE_STRING, dims: [ 1 ] },
  { name: "size", data_type: TYPE_INT32, dims: [ 2 ] },
  { name: "letterbox", data_type: TYPE_FP64, dims: [ 3 ] },
  { name: "det_boxes", data_type: TYPE_FP32, dims: [ -1, 4 ] },
  { name: "det_scores", data_type: TYPE_FP32, dims: [ -1 ] },
  { name: "det_classes", data_type: TYPE_INT32, dims: [ -1 ] },
  { name: "whole_embedding", data_type: TYPE_FP32, dims: [ -1 ] },
  { name: "crop_embeddings", data_type: TYPE_FP32, dims: [ -1, -1 ] },
  { name: "blur_sums", data_type: TYPE_INT64, dims: [ -1, 3 ] },
  { name: "crop_jpegs", data_type: TYPE_STRING, dims: [ -1 ] }
]

instance_group [
  {
    count: 1  # per-profile value (config_templates/profiles/*.json, gpu_image_prep_instances)
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

# Two instances raised ingest from 31.8 to 48.0 images/s on one A6000 (#268); a third added 0.6
# percent. Each instance runs its own worker threads, so the count removes the single-process limit.
#
# GPU memory, per instance: the CuPy pool is capped at POOL_MIB (frames in flight, letterbox and
# squares), plus the CUDA context, the nvJPEG lane buffers and the BLS tensors: 8.2 GB measured at
# 32 streams of 12-24 MP photos. The installer sets the count per profile (minimal and standard 1,
# full 2), so the card holds count x GPU_MIB_PER_INSTANCE. Not in Triton's default load list
# (loaded on first use).
parameters { key: "GPU_MIB_PER_INSTANCE" value: { string_value: "8704" } }
parameters { key: "POOL_MIB" value: { string_value: "4096" } }

# Device-memory admission (1/prep_budget.py). Every photo reserves its decoded frame (and the
# re-oriented copy of a rotated one) from DEVICE_BUDGET_MIB before it decodes and waits for it, at
# most BUDGET_WAIT_SECONDS, instead of failing a CUDA or nvJPEG allocation. The budget is reserved
# once at load: an instance that cannot hold it fails to load (Triton shows the model UNAVAILABLE,
# ingest decodes on the CPU path, visibly). A wait that times out, an allocation that fails anyway
# and a photo larger than the budget are answered with the statuses gpu_memory and over_budget; the
# API counts them as the routes cpu_gpu_memory and cpu_over_budget. Must not exceed POOL_MIB.
parameters { key: "DEVICE_BUDGET_MIB" value: { string_value: "2048" } }
parameters { key: "BUDGET_WAIT_SECONDS" value: { string_value: "20" } }

parameters { key: "FORCE_CPU_ONLY_INPUT_TENSORS" value: { string_value: "yes" } }
parameters { key: "DETECTOR_MODEL" value: { string_value: "yolov11_small_trt_end2end" } }
parameters { key: "PE_MODEL" value: { string_value: "pe_image_encoder" } }
parameters { key: "NET_SIZE" value: { string_value: "640" } }
parameters { key: "LETTERBOX_FILL" value: { string_value: "114" } }
parameters { key: "MIN_MEGAPIXELS" value: { string_value: "0" } }
parameters { key: "MAX_MEGAPIXELS" value: { string_value: "100" } }
parameters { key: "LANES" value: { string_value: "16" } }
# WORKERS and MAX_IN_FLIGHT: more images in flight than the GPU and the allocator can interleave
# inflate the launch-bound stages (letterbox 41 to 5 ms, embed_crops 173 to 51 ms per image at 4
# batches) and slow ingest. Set P, 4 batches, ingest load profile, A6000, same host: WORKERS 16 gave
# +13 to +17 percent over 32 on a quiet host, and 16 workers with 32 in flight gave +9 to +14 percent
# over 32 and 96 in two later sessions on a busy one (38.2 to 41.8 and 35.6 to 40.5 img/s). Lower
# values (12/12, 24/24) could not be told apart from the load of the host. No memory change.
parameters { key: "WORKERS" value: { string_value: "16" } }
parameters { key: "MAX_IN_FLIGHT" value: { string_value: "32" } }
parameters { key: "ENCODE_THREADS" value: { string_value: "8" } }

# Per-stage wall timing is always on (counters op_gpu_prep_stage_seconds and
# op_gpu_prep_stage_observations on Triton's metrics port, see 1/stage_metrics.py). "1" makes a
# kernel stage wait for its stream so the GPU time lands in the stage that ran it: use it for
# attribution runs only, it removes the overlap inside one image.
parameters { key: "STAGE_SYNC" value: { string_value: "0" } }
