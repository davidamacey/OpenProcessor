# PE-Core-L14-336 text encoder — semantic-search query embeddings.
#
# src/clients/pe_encoder.py encodes every query through this Triton model
# (OP_PE_TEXT_TRITON_MODEL names it). The tensor names below are a contract
# with that client.
#
# Input:  text_tokens [B, T] INT64, T <= 32 — PE SimpleTokenizer ids
#         (SOT + BPE + EOT, zero-padded; tokenized in Python by the client,
#         which trims the padding after the batch's last EOT, hence dims -1)
# Output: text_embeddings [B, 1024] FP32, L2-normalized
#
# Model file: 1/model.plan from export/export_pe_text_encoder.py
# (--install-triton writes both; the TensorRT FP16 plan is the default, the
# ONNX Runtime graph is the explicit --platform onnxruntime_onnx fallback). Load it explicitly:
#   --load-model=pe_text_encoder

name: "pe_text_encoder"
platform: "tensorrt_plan"
max_batch_size: 32

input [
  {
    name: "text_tokens"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]

output [
  {
    name: "text_embeddings"
    data_type: TYPE_FP32
    dims: [ 1024 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 4, 8, 16, 32 ]
  max_queue_delay_microseconds: 2000
}

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]
