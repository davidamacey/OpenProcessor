# PE-Core-L14-336 crop encoder — one vector per object box, a model of its own.
#
# Consumed by src/clients/pe_encoder.py (PEEncoder.embed_crops) and the frame engine
# (plan.crop_embed); the vector is stored as the item and box vectors of the crop
# space (examples/embedding/catalog.tsv, pe_core_l14_crop224). The same weights as
# pe_image_encoder built at this input size; its vectors are not comparable with it.
# The tensor names below are a contract with that client.
#
# Input:  images [B, 3, 224, 224] UINT8 RGB pixels,
#         the whole box scaled to fit the square (aspect kept) and padded with grey 128
#         (see src/utils/pe_preprocess.py, letterbox_crop_rgb);
#         the engine scales them and applies PE-Core's 0.5/0.5 mean/std itself
#         (export/uint8_input.py)
# Output: image_embeddings [B, 1024] FP32, L2-normalized
#
# TensorRT plan built by export/build_pe_trt.sh from the ONNX
# produced by export/export_pe_image_encoder.py.
# Engine profile: min=1 / opt=8 / max=32 at 224x224.

name: "pe_crop_encoder"
platform: "tensorrt_plan"
max_batch_size: 32

input [
  {
    name: "images"
    data_type: TYPE_UINT8
    dims: [ 3, 224, 224 ]
  }
]

output [
  {
    name: "image_embeddings"
    data_type: TYPE_FP32
    dims: [ 1024 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 4, 8, 16, 32 ]
  max_queue_delay_microseconds: 15000
}

# No `gpus` list: Triton places `count` instances on every GPU the container
# sees, so TRITON_GPU_ID in .env decides how many cards encode in parallel
# (one card by default; "0,2" runs two). One dynamic-batcher queue feeds all
# instances. Every other model stays pinned to `gpus: [ 0 ]`, the lowest
# listed card. See INSTALLATION.md, "Spreading the PE encoder over GPUs".
instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

# Budget accounting for `openprocessor gpu plan` and the installer: GPU memory
# of one warm instance, recorded with headroom. Measured for the frame encoder at
# max batch 32 (1312 MiB resident on an RTX 3080 Ti, the same on an RTX A6000); the
# crop encoder has the same weights and a smaller input, so the same figure bounds
# it (its own measurement is pending).
parameters: {
  key: "GPU_MIB_PER_INSTANCE"
  value: { string_value: "1536" }
}
