# =============================================================================
# Triton Inference Server with PyTorch for Python Backend (BLS)
# =============================================================================
# Based on NVIDIA Triton 26.10 (CUDA 13.4, TensorRT 11.4, Ubuntu 24.04; release notes:
# https://docs.nvidia.com/deeplearning/triton-inference-server/release-notes/rel-26-10.html) with
# PyTorch + TorchVision for Python backend models (ocr_pipeline).
#
# NOTE: TensorRT engines (.plan) are bound to the TensorRT version that built them.
# Moving between Triton releases that change TRT versions requires
# re-exporting every engine — see docs/MIGRATION_TRITON_26.md.
# =============================================================================

FROM nvcr.io/nvidia/tritonserver:26.10-py3@sha256:b404f7de5dbeeefe0b17d7d149745a50d0989a25d0d831433b5ba63c716c2fcd

LABEL org.opencontainers.image.title="OpenProcessor Inference Server" \
      org.opencontainers.image.description="NVIDIA Triton Inference Server with TensorRT models for visual AI" \
      org.opencontainers.image.vendor="OpenProcessor" \
      org.opencontainers.image.authors="OpenProcessor Contributors" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.source="https://github.com/davidamacey/OpenProcessor" \
      org.opencontainers.image.documentation="https://github.com/davidamacey/OpenProcessor/blob/main/README.md"

# Pull in the latest Ubuntu + NVIDIA security updates on every build; the NGC
# base lags between monthly tags. The base image can ship another TensorRT build than
# the pinned one (26.10's release notes list 11.4.0.106 under contents and 11.4.0.87 in
# the version table), so install exactly TRT_VERSION for every TensorRT package
# the base carries, then hold them: a cold layer cache can then neither
# drift past nor fall behind the lockstep check below (reproducible digest).
# The -dev package names below carry the CUDA minor of the base (13-4 for CUDA 13.4).
# The pin must stay available in NVIDIA's apt repo (the build fails loudly if
# it is not).
#
# Size: the apt upgrade below rewrites every package it touches into a new layer (146 packages,
# ~12 GB, docs/image_size_audit.md). The -dev packages below (headers and static libraries for
# compiling against cuBLAS, cuSOLVER, cuSPARSE, cuSPARSELt, NPP, NCCL and NVSHMEM, plus the
# TensorRT Windows builder resource) are unused at inference and at engine build (trtexec is in
# libnvinfer-bin), so they are removed first, in this RUN, and their rewritten copies never
# exist. The base layer still holds the old files.
ARG TRT_VERSION=11.4.0.106
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update \
    && apt-get remove -y --purge \
         tensorrt-dev \
         libnvinfer-win-builder-resource11 \
         libcublas-dev-13-4 \
         libcusolver-dev-13-4 \
         libcusparse-dev-13-4 \
         libcusparselt0-dev-cuda-13 \
         libnpp-dev-13-4 \
         libnccl-dev \
         libnvshmem3-dev-cuda-13 \
         libnvshmem3-static-cuda-13 \
    && pkgs="$({ dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 'libnvinfer*' 'libnvonnxparsers*' 'libnvparsers*' 'tensorrt*' 2>/dev/null || true; } | awk '$1 == "ii" {print $2}' | sort -u)" \
    && spec="" \
    && for p in $pkgs; do \
         v="$(apt-cache madison "$p" | awk -v t="$TRT_VERSION" '$3 ~ "^" t "-1\\+cuda13" {print $3; exit}')"; \
         [ -n "$v" ] || { echo "ERROR: no $p at TensorRT ${TRT_VERSION} in the apt repo" >&2; exit 1; }; \
         spec="$spec $p=$v"; \
       done \
    && apt-get install -y --no-install-recommends --allow-downgrades $spec \
    && apt-mark hold $pkgs \
    && apt-get upgrade -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
SHELL ["/bin/sh", "-c"]

# Lockstep assertion: serialized engines are TRT-version-locked, so the
# server's TRT and the client-side tensorrt-cu13 pip pin (requirements-export.txt)
# MUST move together. When apt brings a newer
# TRT, this fails the build until the pip pins and this check are bumped in
# the same commit — drift can never ship silently.
RUN actual="$(dpkg-query -W -f='${Version}' libnvinfer-bin)" \
    && case "$actual" in "${TRT_VERSION}"*) echo "TensorRT ${actual} matches pinned ${TRT_VERSION}";; \
       *) echo "ERROR: image TensorRT is ${actual}, expected ${TRT_VERSION}." \
          "Bump tensorrt-cu13 pins in requirements*.txt AND TRT_VERSION here together."; exit 1;; esac

# CVE hygiene beyond apt:
# - Nsight Systems profiler CLI ships Go binaries carrying stdlib CVEs and
#   is dev tooling unused at inference; drop it (also shrinks the image).
# - the in-process `tritonserver` and `tritonfrontend` wheels (imported by nothing here; tritonserver pins numpy<2) and virtualenv
#   (build tooling) are uninstalled so `pip check` below passes with the OpenCV 5 / numpy 2 set.
# - starlette, anyio, certifi, filelock in the image's python env lag their
#   security fixes; docker/triton/requirements-security.txt carries the exact floors.
COPY docker/triton/ /tmp/triton-requirements/
RUN rm -rf /usr/local/cuda-*/NsightSystems-cli-* \
    && pip install --no-cache-dir --upgrade -r /tmp/triton-requirements/requirements-security.txt \
    && pip uninstall -y virtualenv tritonfrontend tritonserver

# PyTorch and TorchVision (CUDA 13.x wheels) for the Python backend models, then OpenCV,
# pyclipper and CuPy (see the header of each requirements file).
RUN pip install --no-cache-dir \
        -r /tmp/triton-requirements/requirements-torch.txt \
        --index-url https://download.pytorch.org/whl/cu132 \
    && pip install --no-cache-dir -r /tmp/triton-requirements/requirements.txt \
    && rm -rf /tmp/triton-requirements \
    && python3 -c "import torch; print(f'PyTorch {torch.__version__} installed, CUDA: {torch.cuda.is_available()}')" \
    && python3 -c "import torchvision; print(f'TorchVision {torchvision.__version__} installed')" \
    && python3 -m pip check

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD ["sh", "-c", "curl -f http://localhost:8000/v2/health/ready || exit 1"]

# Run as the unprivileged user shipped with the NGC image (uid 1000).
# Triton's ports (8000-8002) are unprivileged and /models is a bind mount,
# so root is unnecessary. If the base image drops this user, the build
# fails loudly here rather than silently reverting to root.
USER triton-server

CMD ["tritonserver", "--model-store=/models"]
