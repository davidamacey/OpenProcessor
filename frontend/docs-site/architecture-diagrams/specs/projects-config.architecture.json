        "label": "Project scoping",
        "focus": [
          "url",
          "projectsstore",
          "scoped",
          "projectsapi",
          "projectapi"
        ],
        "note": "The active project is the URL. Its served prefix is selected once and every scoped call is built from it; global calls are explicit."
      },
      {
        "id": "config-store",
        "label": "Per-project config",
        "focus": [
          "projectapi",
          "configdocs",
          "editors"
        ],
        "note": "Packs, profiles, the active VLM and the keymap are revisioned documents the backend stores; editors use the project's prefix."
      },
      {
        "id": "vlm-registry",
        "label": "Shared VLM registry",
        "focus": [
          "vlmregistry",
          "configdocs",
          "editors",
          "secrets"
        ],
        "note": "The registry is deployment-wide; each project activates one endpoint. Keys stay in host secrets; only a reference is shown."
      },
      {
        "id": "sharing",
        "label": "Combine and sharing",
        "focus": [
          "projectsapi",
          "projectapi",
          "models"
        ],
        "note": "Combine builds a new project through the global projects API; promoted models are shared and mapped to classes by name."
      }
    ]
