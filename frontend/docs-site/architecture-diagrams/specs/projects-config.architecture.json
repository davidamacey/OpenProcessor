  "cards": [
    {
      "dot": "cyan",
      "title": "The URL is the project",
      "items": [
        "Nothing about the active project is persisted in the browser",
        "On a switch every per-project cache resets and a late response for the old project is dropped"
      ]
    },
    {
      "dot": "rose",
      "title": "Revisioned, activate-able config",
      "items": [
        "Saves create revisions and carry the revision you started from, so a concurrent edit is a conflict, not an overwrite",
        "Activation pins one revision, can be rolled back, and an impact or validation report precedes it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Secrets never reach the browser",
      "items": [
        "An endpoint stores a reference to a host secret; the app shows the reference and whether the host has it",
        "An endpoint that sends crops outside the deployment needs an explicit acknowledgement"
      ]
    }
  ]
