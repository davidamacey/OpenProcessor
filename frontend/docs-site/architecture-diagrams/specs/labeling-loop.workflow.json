  "cards": [
    {
      "dot": "cyan",
      "title": "The loop closes through the probe, not the export",
      "items": [
        "A promoted checkpoint's probe predictions populate probe_pred_* fields, which the Uncertainty and Model Disagreements review queues need",
        "Re-running auto_label after a promote is what actually surfaces the next cycle's high-signal candidates"
      ]
    },
    {
      "dot": "rose",
      "title": "Test-holdout crops never re-enter labeling",
      "items": [
        "test_holdout=true crops are filtered out at the API level \u2014 the UI never receives them, and the VLM/cluster auto-suggest can't touch them",
        "Export freezes the holdout by a deterministic SHA1-of-crop-id selection, not a client-picked seed"
      ]
    },
    {
      "dot": "emerald",
      "title": "Every stage is thin on the frontend",
      "items": [
        "Clustering, scoring, purity, and promote-gate checks are all server-computed and rendered verbatim \u2014 the UI never re-derives a decision",
        "Bake-off's ranked results, mappings, and winners are entirely served, never computed client-side"
      ]
    }
  ]
}
