PUBLIC_TRITON_API_URL=http://localhost:4603

# Top-bar wordmark + badge letters. Both optional — defaults to
# "Cropwright" / "CW" when unset. Override for a white-label deployment
# without touching source.
# PUBLIC_APP_NAME=Cropwright
# PUBLIC_APP_BADGE=CW

# Path prefix the backend serves its curation endpoints under.
#
# TRANSITIONAL. Defaults to /curation — OpenProcessor's historical prefix —
# purely so the API_PREFIX refactor is behavior-neutral. OpenProcessor's
# canonical prefix is /curation, and this default flips to it in a later
# phase. Leave unset unless you are pointing at a backend started with a
# non-default OP_API_PREFIX.
# PUBLIC_API_PREFIX=/curation
