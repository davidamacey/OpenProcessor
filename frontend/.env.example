PUBLIC_TRITON_API_URL=http://localhost:4603

# Top-bar wordmark + badge letters. Both optional — defaults to
# "Cropwright" / "CW" when unset. Override for a white-label deployment
# without touching source.
# PUBLIC_APP_NAME=Cropwright
# PUBLIC_APP_BADGE=CW

# Path prefix the backend serves its curation endpoints under.
#
# Defaults to /curation, OpenProcessor's API prefix. Leave unset unless
# the backend was started with a non-default OP_API_PREFIX.
# PUBLIC_API_PREFIX=/curation
