{
  "name": "cropwright",
  "private": true,
  "version": "0.1.0",
  "description": "From raw images to a trained detector, without labeling one box at a time. Labeling frontend for OpenProcessor.",
  "license": "MIT",
  "author": "example-org LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidamacey/OpenProcessor.git"
  },
  "homepage": "https://github.com/davidamacey/OpenProcessor#readme",
  "bugs": {
    "url": "https://github.com/davidamacey/OpenProcessor/issues"
  },
  "keywords": [
    "labeling",
    "annotation",
    "computer-vision",
    "dataset",
    "active-learning",
    "sveltekit",
    "yolo",
    "openprocessor"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "node scripts/mutation.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "contract:sync": "node scripts/contract-sync.mjs",
    "contract:check": "node scripts/contract-sync.mjs --check",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:live": "node scripts/run-e2e.mjs e2e/live"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "eslint": "^10.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "eslint-plugin-svelte": "^3.23.0"
  },
  "dependencies": {
    "svelte-dnd-action": "^0.9.79"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "esbuild": "^0.25.10"
  }
}
